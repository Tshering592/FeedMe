<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - FeedMe</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css" />
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link href="https://fonts.googleapis.com/css2?family=Baloo+2:wght@500;600;700;800&family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="~/css/canteen-theme.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    <a href="#main-content" class="fm-skip-link">Skip to content</a>

    @{
        var currentController = ViewContext.RouteData.Values["controller"]?.ToString();
        var currentAction = ViewContext.RouteData.Values["action"]?.ToString();

        bool IsCurrent(string ctrl, string act) =>
            string.Equals(currentController, ctrl, StringComparison.OrdinalIgnoreCase) &&
            string.Equals(currentAction, act, StringComparison.OrdinalIgnoreCase);
    }

    <header>
        <nav class="fm-navbar navbar navbar-expand-sm py-2 mb-4">
            <div class="container">
                <!-- Brand Logo (Acts as Home Button) -->
                <a class="navbar-brand fm-brand m-0 me-4" asp-area="" asp-controller="Home" asp-action="Index">
                    <span class="fm-brand-icon"><i class="bi bi-cup-hot-fill"></i></span>
                    FeedMe
                </a>

                <!-- Mobile Hamburger Toggle -->
                <button class="navbar-toggler fm-navbar-toggler border-0" type="button" data-bs-toggle="collapse" data-bs-target=".navbar-collapse" aria-controls="navbarSupportedContent"
                        aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>

                <!-- Collapsible Navigation Content -->
                <div class="navbar-collapse collapse d-sm-inline-flex justify-content-between align-items-center mt-2 mt-sm-0">


                    <!-- Admin Specific Links -->
                    @if (User.IsInRole("Admin"))
                    {
                        <li class="nav-item">
                            <a class="nav-link fm-nav-link @(IsCurrent("Admin", "Dashboard") ? "active" : "")" asp-area="" asp-controller="Admin" asp-action="Dashboard">Dashboard</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link fm-nav-link @(IsCurrent("Admin", "Inventory") ? "active" : "")" asp-area="" asp-controller="Admin" asp-action="Inventory">Inventory</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link fm-nav-link @(IsCurrent("Admin", "Slots") ? "active" : "")" asp-area="" asp-controller="Admin" asp-action="Slots">Time Slots</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link fm-nav-link @(IsCurrent("Admin", "Users") ? "active" : "")" asp-area="" asp-controller="Admin" asp-action="Users">Users</a>
                        </li>
                    }

                    <!-- Staff Specific Links -->
                    @if (User.IsInRole("Staff"))
                    {
                        <li class="nav-item">
                            <a class="nav-link fm-nav-link @(IsCurrent("Staff", "Dashboard") ? "active" : "")" asp-area="" asp-controller="Staff" asp-action="Dashboard">Orders</a>
                        </li>
                    }

                    <!-- Student Specific Links -->
                    @if (User.IsInRole("Student"))
                    {
                        <li class="nav-item">
                            <a class="nav-link fm-nav-link @(IsCurrent("Student", "History") ? "active" : "")" asp-area="" asp-controller="Student" asp-action="History">My Orders</a>
                        </li>
                    }
                </ul>

                <!-- Right-aligned user info & Auth Actions -->
                <ul class="navbar-nav align-items-sm-center gap-2 m-0 ms-auto mt-2 mt-sm-0">

                    @* Cart icon — uncomment once a Cart controller/action and an item-count
                           source (e.g. ViewBag.CartCount) exist. Left out for now so this
                           doesn't reference functionality that isn't in the project yet.
                        <li class="nav-item">
                            <a class="fm-cart-btn" asp-area="" asp-controller="Cart" asp-action="Index" aria-label="View cart">
                                <i class="bi bi-bag"></i>
                                @if (ViewBag.CartCount != null && (int)ViewBag.CartCount > 0)
                                {
                                    <span class="fm-cart-count">@ViewBag.CartCount</span>
                                }
                            </a>
                        </li>
                        *@

                    @if (User.Identity != null && User.Identity.IsAuthenticated)
                    {
                        <li class="nav-item d-flex align-items-center me-2">
                            <span class="fm-greeting navbar-text">
                                Hello, <strong>@User.Identity.Name</strong>
                                @if (User.IsInRole("Admin"))
                                {
                                    <span class="fm-role-badge fm-role-admin">Admin</span>
                                }
                                else if (User.IsInRole("Staff"))
                                {
                                    <span class="fm-role-badge fm-role-staff">Staff</span>
                                }
                                else if (User.IsInRole("Student"))
                                {
                                    <span class="fm-role-badge fm-role-student">Student</span>
                                }
                            </span>
                        </li>
                        <li class="nav-item">
                            <form asp-area="" asp-controller="Account" asp-action="Logout" method="post" id="logoutForm" class="m-0">
                                @Html.AntiForgeryToken()
                                <button type="submit" class="fm-btn-outline">
                                    Logout
                                </button>
                            </form>
                        </li>
                    }
                    else
                    {
                        <li class="nav-item">
                            <a class="nav-link fm-nav-link" asp-area="" asp-controller="Account" asp-action="Login">Login</a>
                        </li>
                        <li class="nav-item">
                            <a class="fm-btn-primary fm-btn-sm" asp-area="" asp-controller="Account" asp-action="Register">Register</a>
                        </li>
                    }
                </ul>

            </div>
        </div>
    </nav>
</header>

<div class="container">
    <main id="main-content" role="main" class="pb-3">
        @RenderBody()
    </main>
</div>

<script src="~/lib/jquery/dist/jquery.min.js"></script>
<script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
<script src="~/js/site.js" asp-append-version="true"></script>
<script src="~/js/mobile-sidebar.js" asp-append-version="true"></script>

<!-- Global Service Worker Registration for Background Push Notifications -->
<script>
        if ('serviceWorker' in navigator && 'PushManager' in window) {
            navigator.serviceWorker.register('/sw.js')
                .then(function (reg) {
                    console.log('Background Service Worker active:', reg);
                })
                .catch(function (err) {
                    console.error('Service Worker registration failed:', err);
                });
        }
</script>

@await RenderSectionAsync("Scripts", required: false)
</body>
</html>
