@{
    var currentAction = ViewContext.RouteData.Values["action"]?.ToString();
    var currentController = ViewContext.RouteData.Values["controller"]?.ToString();
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - FeedMe Admin</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css" />
    @if (!Environment.GetEnvironmentVariable("ASPNETCORE_ENVIRONMENT")?.Equals("Development", StringComparison.OrdinalIgnoreCase) ?? true)
    {
        <link rel="preconnect" href="https://fonts.googleapis.com">
        <link href="https://fonts.googleapis.com/css2?family=Baloo+2:wght@500;600;700;800&family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
    }
    <link rel="stylesheet" href="~/css/canteen-theme.css" asp-append-version="true" />
    <style>
        /* ── Admin layout shell ───────────────────────────────────── */
        body {
            overflow: hidden;
            background: var(--fm-cream);
        }

        /* Sidebar — same dark chalkboard gradient as the homepage hero */
        .admin-sidebar {
            width: 255px;
            height: 100vh;
            position: fixed;
            top: 0;
            left: 0;
            background: radial-gradient(circle at 20% 20%, rgba(255,255,255,0.04) 0%, transparent 50%),
                        radial-gradient(circle at 50% 50%, #2a221b 0%, #17110d 70%, #0a0705 100%);
            border-right: 1px solid var(--fm-board-edge);
            z-index: 1000;
        }

        /* Brand */
        .admin-brand-icon {
            width: 38px;
            height: 38px;
            border-radius: 50%;
            background: var(--fm-coral);
            color: #fff;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            font-size: 1.1rem;
            flex-shrink: 0;
            box-shadow: 0 2px 8px rgba(228,71,47,0.45);
        }

        .admin-brand-title {
            font-family: var(--fm-font-display);
            font-weight: 800;
            font-size: 0.95rem;
            color: #fff;
            line-height: 1.1;
            letter-spacing: 0.3px;
        }

        .admin-brand-sub {
            font-family: var(--fm-font-body);
            font-size: 0.7rem;
            font-weight: 600;
            color: var(--fm-coral);
            letter-spacing: 0.08em;
            text-transform: uppercase;
        }

        /* Nav links */
        .admin-sidebar .nav-link {
            font-family: var(--fm-font-body);
            font-weight: 500;
            font-size: 0.9rem;
            color: rgba(255,255,255,0.55);
            padding: 0.6rem 0.85rem;
            border-radius: var(--fm-radius-md);
            transition: color var(--fm-transition), background var(--fm-transition);
            display: flex;
            align-items: center;
            gap: 0.6rem;
        }

        .admin-sidebar .nav-link i {
            font-size: 1.05rem;
            flex-shrink: 0;
        }

        .admin-sidebar .nav-link:hover {
            color: #fff;
            background: rgba(255,255,255,0.07);
        }

        .admin-sidebar .nav-link.active {
            color: #fff !important;
            background: var(--fm-coral) !important;
            font-weight: 700;
            box-shadow: 0 3px 10px rgba(228,71,47,0.4);
        }

        .admin-sidebar .sidebar-divider {
            border-color: rgba(255,255,255,0.1);
        }

        /* Logout */
        .admin-sidebar .sidebar-logout {
            font-family: var(--fm-font-body);
            font-weight: 600;
            font-size: 0.88rem;
            color: rgba(255,255,255,0.45);
            background: none;
            border: none;
            padding: 0.55rem 0.85rem;
            border-radius: var(--fm-radius-md);
            width: 100%;
            text-align: left;
            display: flex;
            align-items: center;
            gap: 0.6rem;
            transition: color var(--fm-transition), background var(--fm-transition);
            cursor: pointer;
        }

        .admin-sidebar .sidebar-logout:hover {
            color: var(--fm-coral);
            background: rgba(228,71,47,0.1);
        }

        /* Main content area */
        .admin-main-content {
            margin-left: 255px;
            height: 100vh;
            overflow-y: auto;
            padding: 2rem 2.25rem;
            background: var(--fm-cream);
        }

        /* Typography — same display font as homepage headings */
        .admin-main-content h1,
        .admin-main-content h2,
        .admin-main-content h3,
        .admin-main-content h4,
        .admin-main-content h5 {
            font-family: var(--fm-font-display);
            color: var(--fm-ink);
        }

        /* Cards */
        .admin-main-content .card {
            border: 1px solid var(--fm-border);
            border-radius: var(--fm-radius-lg);
            box-shadow: var(--fm-shadow-sm);
            background: var(--fm-card-bg);
        }

        .admin-main-content .card-header {
            background: var(--fm-card-bg);
            border-bottom: 1px solid var(--fm-border);
            font-family: var(--fm-font-display);
            font-weight: 700;
            color: var(--fm-ink);
            border-radius: var(--fm-radius-lg) var(--fm-radius-lg) 0 0 !important;
        }

        /* Tables */
        .admin-main-content .table {
            font-family: var(--fm-font-body);
            color: var(--fm-ink);
        }

        .admin-main-content .table thead th {
            font-family: var(--fm-font-display);
            font-weight: 700;
            color: var(--fm-ink-soft);
            font-size: 0.78rem;
            text-transform: uppercase;
            letter-spacing: 0.06em;
            border-bottom: 2px solid var(--fm-border);
            background: transparent;
        }

        .admin-main-content .table tbody tr {
            border-bottom: 1px solid var(--fm-border);
            transition: background var(--fm-transition);
        }

        .admin-main-content .table tbody tr:hover {
            background: var(--fm-coral-tint);
        }

        /* Form controls */
        .admin-main-content .form-control,
        .admin-main-content .form-select {
            font-family: var(--fm-font-body);
            border: 1px solid var(--fm-border);
            border-radius: var(--fm-radius-md);
            color: var(--fm-ink);
            background: #fff;
            transition: border-color var(--fm-transition), box-shadow var(--fm-transition);
        }

        .admin-main-content .form-control:focus,
        .admin-main-content .form-select:focus {
            border-color: var(--fm-coral);
            box-shadow: 0 0 0 3px rgba(228,71,47,0.12);
            outline: none;
        }

        /* Buttons — remap to theme coral */
        .admin-main-content .btn-primary {
            background: var(--fm-coral);
            border-color: var(--fm-coral);
            font-family: var(--fm-font-body);
            font-weight: 600;
            border-radius: var(--fm-radius-pill);
        }

        .admin-main-content .btn-primary:hover,
        .admin-main-content .btn-primary:focus {
            background: var(--fm-coral-dark);
            border-color: var(--fm-coral-dark);
            box-shadow: var(--fm-shadow-hover);
        }

        .admin-main-content .btn-danger,
        .admin-main-content .btn-secondary,
        .admin-main-content .btn-outline-secondary,
        .admin-main-content .btn-success,
        .admin-main-content .btn-warning {
            border-radius: var(--fm-radius-pill);
            font-family: var(--fm-font-body);
            font-weight: 600;
        }
    </style>
</head>
<body>
    <div class="d-flex">

        <!-- ── FIXED SIDEBAR ──────────────────────────────────────── -->
        <div class="admin-sidebar d-flex flex-column justify-content-between p-3">
            <div>
                <!-- Brand -->
                <div class="d-flex align-items-center gap-2 mb-4 px-1 pt-1">
                    <span class="admin-brand-icon">
                        <i class="bi bi-cup-hot-fill"></i>
                    </span>
                    <div>
                        <div class="admin-brand-title">TCMIT Canteen</div>
                        <div class="admin-brand-sub">Admin Portal</div>
                    </div>
                </div>

                <!-- Nav -->
                <ul class="nav flex-column gap-1">
                    <li class="nav-item">
                        <a asp-controller="Admin" asp-action="Dashboard"
                           class="nav-link @(currentAction == "Dashboard" ? "active" : "")">
                            <i class="bi bi-grid-fill"></i> Dashboard
                        </a>
                    </li>
                    <li class="nav-item">
                        <a asp-controller="Admin" asp-action="Vault"
                           class="nav-link @(currentAction == "Vault" ? "active" : "")">
                            <i class="bi bi-safe-fill"></i> Token Vault
                        </a>
                    </li>
                    <li class="nav-item">
                        <a asp-controller="Admin" asp-action="Statements"
                           class="nav-link @(currentAction == "Statements" ? "active" : "")">
                            <i class="bi bi-file-earmark-text-fill"></i> Statements
                        </a>
                    </li>
                    <li class="nav-item">
                        <a asp-controller="Admin" asp-action="Inventory"
                           class="nav-link @(currentAction == "Inventory" ? "active" : "")">
                            <i class="bi bi-box-seam-fill"></i> Inventory
                        </a>
                    </li>
                    <li class="nav-item">
                        <a asp-controller="Admin" asp-action="Menu"
                           class="nav-link @(currentAction == "Menu" ? "active" : "")">
                            <i class="bi bi-list-task"></i> Menu Management
                        </a>
                    </li>
                    <li class="nav-item">
                        <a asp-controller="Admin" asp-action="Orders"
                           class="nav-link @(currentAction == "Orders" ? "active" : "")">
                            <i class="bi bi-receipt"></i> Orders
                        </a>
                    </li>
                    <li class="nav-item">
                        <a asp-controller="Admin" asp-action="Slots"
                           class="nav-link @(currentAction == "Slots" ? "active" : "")">
                            <i class="bi bi-clock-fill"></i> Time Slots
                        </a>
                    </li>
                    <li class="nav-item">
                        <a asp-controller="Admin" asp-action="Users"
                           class="nav-link @(currentAction == "Users" ? "active" : "")">
                            <i class="bi bi-people-fill"></i> Users
                        </a>
                    </li>
                </ul>
            </div>

            <!-- Logout -->
            <div class="px-1 pb-1">
                <hr class="sidebar-divider my-3" />
                <form asp-controller="Account" asp-action="Logout" method="post">
                    @Html.AntiForgeryToken()
                    <button type="submit" class="sidebar-logout">
                        <i class="bi bi-box-arrow-right"></i> Logout
                    </button>
                </form>
            </div>
        </div>

        <!-- ── SCROLLABLE MAIN CONTENT ────────────────────────────── -->
        <main class="admin-main-content w-100">
            @RenderBody()
        </main>

    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>