@using FeedMe.Models
@{
    ViewData["Title"] = "Full Canteen Menu - Student";
    var user = ViewBag.User as AppUser;
    var menuItems = ViewBag.MenuItems as List<MenuItem> ?? new List<MenuItem>();
    var categories = ViewBag.Categories as List<Category> ?? new List<Category>();
    var timeSlots = ViewBag.TimeSlots as List<TimeSlot> ?? new List<TimeSlot>();
    int? selectedCategoryId = ViewBag.SelectedCategoryId as int?;
}

<style>
    header, footer, nav.navbar, .navbar {
        display: none !important;
    }

    html, body {
        background-color: #f8fafc !important;
        margin: 0 !important;
        padding: 0 !important;
        height: 100vh !important;
        overflow: hidden !important;
    }

    .admin-sidebar {
        width: 250px;
        height: 100vh;
        position: fixed;
        top: 0;
        left: 0;
        background-color: #0f172a;
        z-index: 1000;
        overflow-y: auto;
    }

    .admin-main-content {
        position: fixed !important;
        top: 0 !important;
        left: 250px !important;
        right: 0 !important;
        bottom: 0 !important;
        height: 100vh !important;
        overflow-y: auto !important;
        padding: 24px 32px !important;
        box-sizing: border-box !important;
        background-color: #f8fafc !important;
    }
</style>

<div class="d-flex">
    <!-- STUDENT SIDEBAR -->
    <div class="admin-sidebar text-white p-3 d-flex flex-column justify-content-between">
        <div>
            <div class="d-flex align-items-center gap-3 mb-4 pb-3 border-bottom border-secondary border-opacity-25">
                <div class="bg-danger rounded-circle p-2 d-flex align-items-center justify-content-center shadow-sm" style="width: 42px; height: 42px; min-width: 42px;">
                    <i class="bi bi-cup-hot-fill text-white fs-5"></i>
                </div>
                <div class="text-truncate">
                    <h6 class="fw-bold m-0 text-white text-truncate" style="font-size: 0.95rem;">TCMIT CANTEEN</h6>
                    <span class="text-danger small fw-semibold" style="font-size: 0.75rem;">Student Portal</span>
                </div>
            </div>

            <ul class="nav nav-pills flex-column gap-2">
                <li class="nav-item">
                    <a asp-action="Dashboard" class="nav-link text-secondary fw-semibold rounded-3 py-2 px-3 text-white-50"><i class="bi bi-grid-fill me-2 fs-5 align-middle"></i> Dashboard</a>
                </li>
                <li class="nav-item">
                    <!-- ACTIVE LINK CORRECTED -->
                    <a asp-action="FullMenu" class="nav-link active bg-danger fw-bold rounded-3 py-2 px-3"><i class="bi bi-journal-text me-2 fs-5 align-middle"></i> Canteen Menu</a>
                </li>
                <li class="nav-item">
                    <a asp-action="Orders" class="nav-link text-secondary fw-semibold rounded-3 py-2 px-3 text-white-50"><i class="bi bi-clock-history me-2 fs-5 align-middle"></i> My Orders</a>
                </li>
                <li class="nav-item">
                    <a asp-action="Vault" class="nav-link text-secondary fw-semibold rounded-3 py-2 px-3 text-white-50"><i class="bi bi-safe-fill me-2 fs-5 align-middle"></i> Token Vault</a>
                </li>
                <li class="nav-item">
                    <a asp-action="Statements" class="nav-link text-secondary fw-semibold rounded-3 py-2 px-3 text-white-50"><i class="bi bi-file-earmark-text-fill me-2 fs-5 align-middle"></i> Statement</a>
                </li>
                <li class="nav-item">
                    <a asp-action="Notifications" class="nav-link text-secondary fw-semibold rounded-3 py-2 px-3 text-white-50"><i class="bi bi-bell-fill me-2 fs-5 align-middle"></i> Notifications</a>
                </li>
                <li class="nav-item">
                    <a asp-action="Profile" class="nav-link text-secondary fw-semibold rounded-3 py-2 px-3 text-white-50"><i class="bi bi-person-circle me-2 fs-5 align-middle"></i> Profile</a>
                </li>
            </ul>
        </div>

        <div class="pt-3 border-top border-secondary border-opacity-25">
            <form asp-controller="Account" asp-action="Logout" method="post">
                @Html.AntiForgeryToken()
                <button type="submit" class="btn text-danger w-100 text-start fw-bold p-0 border-0 bg-transparent">
                    <i class="bi bi-box-arrow-left me-2 fs-5 align-middle"></i> Logout
                </button>
            </form>
        </div>
    </div>

    <!-- MAIN CONTENT -->
    <div class="admin-main-content">
        <!-- ALERT BANNERS FOR ERROR & SUCCESS MESSAGES -->
        @if (TempData["Error"] != null)
        {
            <div class="alert alert-danger alert-dismissible fade show rounded-4 border-0 shadow-sm mb-4" role="alert">
                <i class="bi bi-exclamation-triangle-fill me-2 fs-5 align-middle"></i>
                <strong>@TempData["Error"]</strong>
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
            </div>
        }
        @if (TempData["Success"] != null)
        {
            <div class="alert alert-success alert-dismissible fade show rounded-4 border-0 shadow-sm mb-4" role="alert">
                <i class="bi bi-check-circle-fill me-2 fs-5 align-middle"></i>
                <strong>@TempData["Success"]</strong>
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
            </div>
        }

        <form asp-action="PlaceMultiOrder" method="post">
            @Html.AntiForgeryToken()
            <input type="hidden" name="categoryId" value="@selectedCategoryId" />

            <!-- HEADER PAGE BANNER & BALANCE INDICATOR -->
            <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center mb-4 gap-3">
                <div>
                    <h3 class="fw-bold text-dark m-0">Full Canteen Menu</h3>
                    <p class="text-muted small m-0 mt-1">Select items, pick a collection time slot, and place your order using Texas Tokens.</p>
                </div>
                <div class="d-flex align-items-center gap-3">
                    <div class="bg-white border rounded-pill px-3 py-2 shadow-sm d-flex align-items-center gap-2">
                        <i class="bi bi-coin text-warning fs-5"></i>
                        <span class="small fw-semibold text-muted">Wallet Balance:</span>
                        <span class="fw-bold text-success">@(user?.TokenBalance ?? 0) Tokens</span>
                    </div>
                    <button type="submit" class="btn btn-danger rounded-pill px-4 py-2 fw-bold shadow-sm">
                        <i class="bi bi-cart-check me-1"></i> Submit Multi-Item Order
                    </button>
                </div>
            </div>

            <!-- CATEGORY FILTER BUTTONS -->
            <div class="d-flex flex-wrap gap-2 mb-4">
                <a asp-action="FullMenu" class="btn btn-sm rounded-pill px-3 py-2 fw-bold @(!selectedCategoryId.HasValue ? "btn-danger shadow-sm" : "btn-outline-secondary bg-white")">
                    All Categories
                </a>
                @foreach (var cat in categories)
                {
                    <a asp-action="FullMenu" asp-route-categoryId="@cat.Id" class="btn btn-sm rounded-pill px-3 py-2 fw-bold @(selectedCategoryId == cat.Id ? "btn-danger shadow-sm" : "btn-outline-secondary bg-white")">
                        @cat.Name
                    </a>
                }
            </div>

            <!-- Time Slot Selection -->
            <div class="card border-0 shadow-sm rounded-4 bg-white p-3 mb-4">
                <label class="form-label fw-bold text-dark mb-1">
                    <i class="bi bi-clock-history text-danger me-1"></i> Select Pickup Time Slot
                </label>
                <select name="TimeSlotId" class="form-select rounded-3" required>
                    <option value="">-- Choose Pickup Slot --</option>
                    @foreach (var slot in timeSlots)
                    {
                        <option value="@slot.Id">@slot.StartTime.ToString(@"hh\:mm") - @slot.EndTime.ToString(@"hh\:mm")</option>
                    }
                </select>
            </div>

            <!-- Food Items Table -->
            <div class="card border-0 shadow-sm rounded-4 bg-white overflow-hidden">
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0">
                        <thead class="table-light">
                            <tr>
                                <th class="border-0 text-secondary small fw-bold text-uppercase ps-4">Image</th>
                                <th class="border-0 text-secondary small fw-bold text-uppercase">Item Details</th>
                                <th class="border-0 text-secondary small fw-bold text-uppercase text-center">Category</th>
                                <th class="border-0 text-secondary small fw-bold text-uppercase text-center">Price</th>
                                <th class="border-0 text-secondary small fw-bold text-uppercase text-center pe-4">Select Quantity</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (!menuItems.Any())
                            {
                                <tr>
                                    <td colspan="5" class="text-center text-muted py-5">
                                        <i class="bi bi-search fs-1 text-muted d-block mb-2"></i>
                                        No items found in this category. Try selecting "All Categories" or check back later.
                                    </td>
                                </tr>
                            }
                            else
                            {
                                for (int i = 0; i < menuItems.Count; i++)
                                {
                                    var item = menuItems[i];
                                    <tr>
                                        <td class="ps-4" style="width: 90px;">
                                            @if (!string.IsNullOrEmpty(item.ImageUrl))
                                            {
                                                <img src="@item.ImageUrl" alt="@item.Name" class="rounded-3 object-fit-cover shadow-sm" style="width: 54px; height: 54px;" />
                                            }
                                            else
                                            {
                                                <div class="bg-light rounded-3 d-flex align-items-center justify-content-center text-muted shadow-sm" style="width: 54px; height: 54px;">
                                                    <i class="bi bi-image fs-4"></i>
                                                </div>
                                            }
                                        </td>
                                        <td>
                                            <h6 class="fw-bold text-dark m-0">@item.Name</h6>
                                            <p class="text-muted small m-0 text-truncate" style="max-width: 320px;">@item.Description</p>
                                        </td>
                                        <td class="text-center">
                                            <span class="badge bg-light text-dark border rounded-pill px-3 py-1 fw-bold">@(item.Category?.Name ?? "General")</span>
                                        </td>
                                        <td class="text-center">
                                            <span class="badge bg-danger bg-opacity-10 text-danger rounded-pill px-3 py-1 fw-bold fs-6">
                                                <i class="bi bi-coin text-warning me-1"></i>@item.Price.ToString("F0")
                                            </span>
                                        </td>
                                        <td class="text-center pe-4" style="width: 160px;">
                                            <input type="hidden" name="SelectedItems[@i].MenuItemId" value="@item.Id" />
                                            <input type="number" min="0" max="10" name="SelectedItems[@i].Quantity" value="0" class="form-control text-center rounded-3 fw-bold border" />
                                        </td>
                                    </tr>
                                }
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </form>
    </div>
</div>