@using FeedMe.Models
@model List<Order>
@{
    ViewData["Title"] = "My Orders - Student Portal";
    var user = ViewBag.User as AppUser;

    var currentAction = ViewContext.RouteData.Values["action"]?.ToString();
}

<style>
    header, footer, nav.navbar, .navbar {
        display: none !important;
    }

    html, body {
        background-color: #f8fafc !important;
        margin: 0 !important;
        padding: 0 !important;
        height: 100vh !important;
        overflow: hidden !important;
    }

    .admin-sidebar {
        width: 250px;
        height: 100vh;
        height: 100dvh;
        position: fixed;
        top: 0;
        left: 0;
        background-color: #0f172a;
        z-index: 1000;
    }

    .admin-main-content {
        margin-left: 250px;
        width: calc(100vw - 250px);
        height: 100vh;
        overflow-y: auto;
        padding: 24px 32px !important;
        box-sizing: border-box;
    }

    /* Slim top bar shown only on mobile, with a hamburger button to open the drawer */
    .mobile-topbar {
        display: none;
        position: fixed;
        top: 0;
        left: 0;
        right: 0;
        height: 56px;
        background-color: #0f172a;
        z-index: 1030;
        align-items: center;
        gap: 12px;
        padding: 0 16px;
    }

    .mobile-nav-toggle {
        background: transparent;
        border: none;
        color: #ffffff;
        font-size: 1.5rem;
        line-height: 1;
        padding: 4px;
    }

    .sidebar-backdrop {
        display: none;
        position: fixed;
        inset: 0;
        background: rgba(0, 0, 0, 0.5);
        z-index: 1040;
    }

        .sidebar-backdrop.show {
            display: block;
        }

    /* Responsive: sidebar becomes a sliding off-canvas drawer instead of squeezing content */
    @@media (max-width: 900px) {
        .mobile-topbar {
            display: flex;
        }

        .admin-sidebar {
            width: 260px !important;
            height: 100vh !important;
            height: 100dvh;
            position: fixed !important;
            top: 0 !important;
            left: 0 !important;
            transform: translateX(-100%);
            transition: transform 0.25s ease;
            z-index: 1050;
            flex-direction: column !important;
            padding: 16px !important;
            overflow-y: auto !important;
        }

            .admin-sidebar.mobile-open {
                transform: translateX(0);
            }

            .admin-sidebar .nav {
                flex-direction: column !important;
                gap: 8px !important;
            }

        .admin-main-content {
            margin-left: 0 !important;
            width: 100% !important;
            margin-top: 56px !important;
            height: calc(100vh - 56px) !important;
            padding: 16px 20px !important;
        }
    }
</style>

<!-- MOBILE TOP BAR (hamburger + brand) -->
<div class="mobile-topbar">
    <button type="button" class="mobile-nav-toggle" aria-label="Toggle menu">
        <i class="bi bi-list"></i>
    </button>
    <span class="fw-bold text-white">TCMIT CANTEEN</span>
</div>
<div class="sidebar-backdrop"></div>

<div class="d-flex">
    <!-- SIDEBAR -->
    <div class="admin-sidebar text-white p-3 d-flex flex-column justify-content-between">
        <div>
            <div class="d-flex align-items-center gap-3 mb-4 pb-3 border-bottom border-secondary border-opacity-25">
                <div class="bg-danger rounded-circle p-2 d-flex align-items-center justify-content-center shadow-sm" style="width: 42px; height: 42px; min-width: 42px;">
                    <i class="bi bi-cup-hot-fill text-white fs-5"></i>
                </div>
                <div class="text-truncate">
                    <h6 class="fw-bold m-0 text-white text-truncate" style="font-size: 0.95rem;">TCMIT CANTEEN</h6>
                    <span class="text-danger small fw-semibold" style="font-size: 0.75rem;">Student Portal</span>
                </div>
            </div>

            <!-- DYNAMIC SIDEBAR LINKS -->
            <ul class="nav nav-pills flex-column gap-2">
                <li class="nav-item">
                    <a asp-action="Dashboard" class="nav-link rounded-3 py-2 px-3 @(currentAction == "Dashboard" ? "active bg-danger fw-bold text-white" : "text-secondary fw-semibold text-white-50")">
                        <i class="bi bi-grid-fill me-2 fs-5 align-middle"></i> Dashboard
                    </a>
                </li>
                <li class="nav-item">
                    <a asp-action="FullMenu" class="nav-link rounded-3 py-2 px-3 @(currentAction == "FullMenu" ? "active bg-danger fw-bold text-white" : "text-secondary fw-semibold text-white-50")">
                        <i class="bi bi-journal-text me-2 fs-5 align-middle"></i> Canteen Menu
                    </a>
                </li>
                <li class="nav-item">
                    <a asp-action="Orders" class="nav-link rounded-3 py-2 px-3 @(currentAction == "Orders" ? "active bg-danger fw-bold text-white" : "text-secondary fw-semibold text-white-50")">
                        <i class="bi bi-clock-history me-2 fs-5 align-middle"></i> My Orders
                    </a>
                </li>
                <li class="nav-item">
                    <!-- VAULT LINK WITH VAULT ICON -->
                    <a asp-action="Vault" class="nav-link rounded-3 py-2 px-3 @(currentAction == "Vault" ? "active bg-danger fw-bold text-white" : "text-secondary fw-semibold text-white-50")">
                        <i class="bi bi-safe-fill me-2 fs-5 align-middle"></i> Token Vault
                    </a>
                </li>
                <li class="nav-item">
                    <!-- STATEMENT LINK WITH STATEMENT ICON -->
                    <a asp-action="Statements" class="nav-link rounded-3 py-2 px-3 @(currentAction == "Statements" ? "active bg-danger fw-bold text-white" : "text-secondary fw-semibold text-white-50")">
                        <i class="bi bi-file-earmark-text-fill me-2 fs-5 align-middle"></i> Statement
                    </a>
                </li>
                <li class="nav-item">
                    <a asp-action="Notifications" class="nav-link rounded-3 py-2 px-3 @(currentAction == "Notifications" ? "active bg-danger fw-bold text-white" : "text-secondary fw-semibold text-white-50")">
                        <i class="bi bi-bell-fill me-2 fs-5 align-middle"></i> Notifications
                    </a>
                </li>
                <li class="nav-item">
                    <a asp-action="Profile" class="nav-link rounded-3 py-2 px-3 @(currentAction == "Profile" ? "active bg-danger fw-bold text-white" : "text-secondary fw-semibold text-white-50")">
                        <i class="bi bi-person-circle me-2 fs-5 align-middle"></i> Profile
                    </a>
                </li>
            </ul>
        </div>

        <div class="pt-3 border-top border-secondary border-opacity-25">
            <form asp-controller="Account" asp-action="Logout" method="post">
                @Html.AntiForgeryToken()
                <button type="submit" class="btn text-danger w-100 text-start fw-bold p-0 border-0 bg-transparent">
                    <i class="bi bi-box-arrow-left me-2 fs-5 align-middle"></i> Logout
                </button>
            </form>
        </div>
    </div>

    <!-- MAIN CONTENT -->
    <div class="admin-main-content">
        <div class="d-flex justify-content-between align-items-center mb-4">
            <div>
                <h3 class="fw-bold text-dark m-0">My Order Records</h3>
                <p class="text-muted small m-0">Track all your past and live canteen orders.</p>
            </div>
            <a asp-action="FullMenu" class="btn btn-danger rounded-pill px-4 fw-bold shadow-sm">
                <i class="bi bi-plus-lg me-1"></i> New Order
            </a>
        </div>

        <div class="card border-0 shadow-sm rounded-4 bg-white overflow-hidden w-100">
            @if (Model == null || !Model.Any())
            {
                <div class="p-5 text-center">
                    <i class="bi bi-receipt fs-1 text-muted d-block mb-2"></i>
                    <h6 class="fw-bold text-dark m-0">No order history found</h6>
                    <p class="text-muted small mt-1">Place an order from the canteen menu to see records here.</p>
                </div>
            }
            else
            {
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0 text-nowrap w-100">
                        <thead class="bg-light">
                            <tr>
                                <th class="ps-4">Token</th>
                                <th>Date & Time</th>
                                <th>Pickup Slot</th>
                                <th>Items Ordered</th>
                                <th>Total Amount</th>
                                <th>Status</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var order in Model)
                            {
                                <tr>
                                    <td class="ps-4 fw-bold text-danger">#@order.Id.ToString("D3")</td>
                                    <td class="small text-muted">@order.OrderTime.ToString("yyyy-MM-dd HH:mm")</td>
                                    <td class="small fw-semibold">
                                        @(order.TimeSlot != null ? $"{order.TimeSlot.StartTime:hh\\:mm} - {order.TimeSlot.EndTime:hh\\:mm}" : "Standard")
                                    </td>
                                    <td class="small text-muted">
                                        @if (order.OrderItems != null && order.OrderItems.Any())
                                        {
                                            @string.Join(", ", order.OrderItems.Select(i => $"{i.MenuItem?.Name} (x{i.Quantity})"))
                                        }
                                        else
                                        {
                                            <span>-</span>
                                        }
                                    </td>
                                    <td class="fw-bold text-dark">
                                        <span class="d-inline-flex align-items-center gap-1">
                                            <i class="bi bi-coin text-warning fs-6"></i> @order.TotalAmount.ToString("N0") Tokens
                                        </span>
                                    </td>
                                    <td>
                                        <span class="badge rounded-pill px-3 py-2 fw-bold
                                            @(order.Status == OrderStatus.Completed ? "bg-success-subtle text-success border border-success-subtle" :
                                              order.Status == OrderStatus.Cancelled ? "bg-danger-subtle text-danger border border-danger-subtle" : "bg-warning-subtle text-warning border border-warning-subtle")">
                                            @order.Status
                                        </span>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>
    </div>
</div>