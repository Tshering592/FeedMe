@using FeedMe.Models
@model AppUser
@{
    ViewData["Title"] = "Student Profile";

    var currentAction = ViewContext.RouteData.Values["action"]?.ToString();
}

<style>
    header, footer, nav.navbar, .navbar {
        display: none !important;
    }

    html, body {
        background-color: #f8fafc !important;
        margin: 0 !important;
        padding: 0 !important;
        height: 100vh !important;
        overflow: hidden !important;
    }

    .admin-sidebar {
        width: 250px;
        height: 100vh;
        height: 100dvh;
        position: fixed;
        top: 0;
        left: 0;
        background-color: #0f172a;
        z-index: 1000;
    }

    .admin-main-content {
        margin-left: 250px;
        width: calc(100vw - 250px);
        height: 100vh;
        overflow-y: auto;
        padding: 24px 32px !important;
        box-sizing: border-box;
    }

    /* Slim top bar shown only on mobile, with a hamburger button to open the drawer */
    .mobile-topbar {
        display: none;
        position: fixed;
        top: 0;
        left: 0;
        right: 0;
        height: 56px;
        background-color: #0f172a;
        z-index: 1030;
        align-items: center;
        gap: 12px;
        padding: 0 16px;
    }

    .mobile-nav-toggle {
        background: transparent;
        border: none;
        color: #ffffff;
        font-size: 1.5rem;
        line-height: 1;
        padding: 4px;
    }

    .sidebar-backdrop {
        display: none;
        position: fixed;
        inset: 0;
        background: rgba(0, 0, 0, 0.5);
        z-index: 1040;
    }

        .sidebar-backdrop.show {
            display: block;
        }

    /* Responsive: sidebar becomes a sliding off-canvas drawer instead of squeezing content */
    @@media (max-width: 900px) {
        .mobile-topbar {
            display: flex;
        }

        .admin-sidebar {
            width: 260px !important;
            height: 100vh !important;
            height: 100dvh;
            position: fixed !important;
            top: 0 !important;
            left: 0 !important;
            transform: translateX(-100%);
            transition: transform 0.25s ease;
            z-index: 1050;
            flex-direction: column !important;
            padding: 16px !important;
            overflow-y: auto !important;
        }

            .admin-sidebar.mobile-open {
                transform: translateX(0);
            }

            .admin-sidebar .nav {
                flex-direction: column !important;
                gap: 8px !important;
            }

        .admin-main-content {
            margin-left: 0 !important;
            width: 100% !important;
            margin-top: 56px !important;
            height: calc(100vh - 56px) !important;
            padding: 16px 20px !important;
        }
    }
</style>

<!-- MOBILE TOP BAR (hamburger + brand) -->
<div class="mobile-topbar">
    <button type="button" class="mobile-nav-toggle" aria-label="Toggle menu">
        <i class="bi bi-list"></i>
    </button>
    <span class="fw-bold text-white">TCMIT CANTEEN</span>
</div>
<div class="sidebar-backdrop"></div>

<div class="d-flex">
    <!-- SIDEBAR -->
    <div class="admin-sidebar text-white p-3 d-flex flex-column justify-content-between">
        <div>
            <div class="d-flex align-items-center gap-3 mb-4 pb-3 border-bottom border-secondary border-opacity-25">
                <div class="bg-danger rounded-circle p-2 d-flex align-items-center justify-content-center shadow-sm" style="width: 42px; height: 42px; min-width: 42px;">
                    <i class="bi bi-cup-hot-fill text-white fs-5"></i>
                </div>
                <div class="text-truncate">
                    <h6 class="fw-bold m-0 text-white text-truncate" style="font-size: 0.95rem;">TCMIT CANTEEN</h6>
                    <span class="text-danger small fw-semibold" style="font-size: 0.75rem;">Student Portal</span>
                </div>
            </div>

            <!-- DYNAMIC SIDEBAR LINKS -->
            <ul class="nav nav-pills flex-column gap-2">
                <li class="nav-item">
                    <a asp-action="Dashboard" class="nav-link rounded-3 py-2 px-3 @(currentAction == "Dashboard" ? "active bg-danger fw-bold text-white" : "text-secondary fw-semibold text-white-50")">
                        <i class="bi bi-grid-fill me-2 fs-5 align-middle"></i> Dashboard
                    </a>
                </li>
                <li class="nav-item">
                    <a asp-action="FullMenu" class="nav-link rounded-3 py-2 px-3 @(currentAction == "FullMenu" ? "active bg-danger fw-bold text-white" : "text-secondary fw-semibold text-white-50")">
                        <i class="bi bi-journal-text me-2 fs-5 align-middle"></i> Canteen Menu
                    </a>
                </li>
                <li class="nav-item">
                    <a asp-action="Orders" class="nav-link rounded-3 py-2 px-3 @(currentAction == "Orders" ? "active bg-danger fw-bold text-white" : "text-secondary fw-semibold text-white-50")">
                        <i class="bi bi-clock-history me-2 fs-5 align-middle"></i> My Orders
                    </a>
                </li>
                <li class="nav-item">
                    <!-- VAULT LINK WITH VAULT ICON -->
                    <a asp-action="Vault" class="nav-link rounded-3 py-2 px-3 @(currentAction == "Vault" ? "active bg-danger fw-bold text-white" : "text-secondary fw-semibold text-white-50")">
                        <i class="bi bi-safe-fill me-2 fs-5 align-middle"></i> Token Vault
                    </a>
                </li>
                <li class="nav-item">
                    <!-- STATEMENT LINK WITH STATEMENT ICON -->
                    <a asp-action="Statements" class="nav-link rounded-3 py-2 px-3 @(currentAction == "Statements" ? "active bg-danger fw-bold text-white" : "text-secondary fw-semibold text-white-50")">
                        <i class="bi bi-file-earmark-text-fill me-2 fs-5 align-middle"></i> Statement
                    </a>
                </li>
                <li class="nav-item">
                    <a asp-action="Notifications" class="nav-link rounded-3 py-2 px-3 @(currentAction == "Notifications" ? "active bg-danger fw-bold text-white" : "text-secondary fw-semibold text-white-50")">
                        <i class="bi bi-bell-fill me-2 fs-5 align-middle"></i> Notifications
                    </a>
                </li>
                <li class="nav-item">
                    <a asp-action="Profile" class="nav-link rounded-3 py-2 px-3 @(currentAction == "Profile" ? "active bg-danger fw-bold text-white" : "text-secondary fw-semibold text-white-50")">
                        <i class="bi bi-person-circle me-2 fs-5 align-middle"></i> Profile
                    </a>
                </li>
            </ul>
        </div>

        <div class="pt-3 border-top border-secondary border-opacity-25">
            <form asp-controller="Account" asp-action="Logout" method="post">
                @Html.AntiForgeryToken()
                <button type="submit" class="btn text-danger w-100 text-start fw-bold p-0 border-0 bg-transparent">
                    <i class="bi bi-box-arrow-left me-2 fs-5 align-middle"></i> Logout
                </button>
            </form>
        </div>
    </div>

    <!-- MAIN CONTENT -->
    <div class="admin-main-content">
        <div class="mb-4">
            <h3 class="fw-bold text-dark m-0">Student Profile Settings</h3>
            <p class="text-muted small m-0">View and update your profile details below.</p>
        </div>

        @if (TempData["Success"] != null)
        {
            <div class="alert alert-success alert-dismissible fade show rounded-4 border-0 shadow-sm mb-4">
                <i class="bi bi-check-circle-fill me-2"></i> @TempData["Success"]
                <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
            </div>
        }

        <div class="card border-0 shadow-sm rounded-4 bg-white p-4 w-100">
            <form asp-action="UpdateProfile" method="post">
                @Html.AntiForgeryToken()

                <div class="row g-3 mb-3">
                    <div class="col-md-6">
                        <label class="form-label fw-bold text-dark">Full Name</label>
                        <input type="text" name="fullName" class="form-control rounded-3" value="@Model?.FullName" required />
                    </div>
                    <div class="col-md-6">
                        <label class="form-label fw-bold text-dark">Email Address</label>
                        <input type="email" class="form-control rounded-3 bg-light" value="@Model?.Email" readonly />
                    </div>
                </div>

                <div class="row g-3 mb-3">
                    <div class="col-md-6">
                        <label class="form-label fw-bold text-dark">Student LCID / ID</label>
                        <input type="text" class="form-control rounded-3 bg-light" value="@(Model?.StudentLcid ?? Model?.StudentId ?? "N/A")" readonly />
                    </div>
                    <div class="col-md-6">
                        <label class="form-label fw-bold text-dark">Semester</label>
                        <input type="text" class="form-control rounded-3 bg-light" value="@(Model?.Semester ?? "N/A")" readonly />
                    </div>
                </div>

                <div class="row g-3 mb-4">
                    <div class="col-md-6">
                        <label class="form-label fw-bold text-dark">Contact Number</label>
                        <input type="text" name="contactNumber" class="form-control rounded-3" value="@Model?.ContactNumber" required />
                    </div>
                    <div class="col-md-6">
                        <label class="form-label fw-bold text-dark">Dietary Preference</label>
                        <select name="dietaryPreference" class="form-select rounded-3">
                            <option value="Veg" selected="@(Model?.DietaryPreference == "Veg")">Vegetarian (Veg)</option>
                            <option value="Non-Veg" selected="@(Model?.DietaryPreference == "Non-Veg")">Non-Vegetarian (Non-Veg)</option>
                            <option value="ALL" selected="@(Model?.DietaryPreference == "ALL" || string.IsNullOrEmpty(Model?.DietaryPreference))">No Specific Preference (All)</option>
                        </select>
                    </div>
                </div>

                <div class="text-end">
                    <button type="submit" class="btn btn-danger rounded-pill px-4 fw-bold shadow-sm">
                        <i class="bi bi-save me-1"></i> Save Changes
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>