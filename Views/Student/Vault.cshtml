@using FeedMe.Models
@{
    ViewData["Title"] = "My Token Vault - Student Portal";
    var user = ViewBag.User as AppUser;
    var recentActivity = ViewBag.RecentActivity as List<TokenTransaction> ?? new List<TokenTransaction>();
}

<style>
    header, footer, nav.navbar, .navbar {
        display: none !important;
    }

    html, body {
        background-color: #f8fafc !important;
        margin: 0 !important;
        padding: 0 !important;
        height: 100vh !important;
        overflow: hidden !important;
    }

    .admin-sidebar {
        width: 250px;
        height: 100vh;
        position: fixed;
        top: 0;
        left: 0;
        background-color: #0f172a;
        z-index: 1000;
        overflow-y: auto;
    }

    .admin-main-content {
        position: fixed !important;
        top: 0 !important;
        left: 250px !important;
        right: 0 !important;
        bottom: 0 !important;
        height: 100vh !important;
        overflow-y: auto !important;
        padding: 32px 40px !important;
        box-sizing: border-box !important;
        background-color: #f8fafc !important;
    }
</style>

<div class="d-flex">
    <!-- STUDENT SIDEBAR -->
    <div class="admin-sidebar text-white p-3 d-flex flex-column justify-content-between">
        <div>
            <div class="d-flex align-items-center gap-3 mb-4 pb-3 border-bottom border-secondary border-opacity-25">
                <div class="bg-danger rounded-circle p-2 d-flex align-items-center justify-content-center shadow-sm" style="width: 42px; height: 42px; min-width: 42px;">
                    <i class="bi bi-cup-hot-fill text-white fs-5"></i>
                </div>
                <div class="text-truncate">
                    <h6 class="fw-bold m-0 text-white text-truncate" style="font-size: 0.95rem;">TCMIT CANTEEN</h6>
                    <span class="text-danger small fw-semibold" style="font-size: 0.75rem;">Student Portal</span>
                </div>
            </div>

            <ul class="nav nav-pills flex-column gap-2">
                <li class="nav-item">
                    <a asp-action="Dashboard" class="nav-link text-secondary fw-semibold rounded-3 py-2 px-3 text-white-50"><i class="bi bi-grid-fill me-2 fs-5 align-middle"></i> Dashboard</a>
                </li>
                <li class="nav-item">
                    <a asp-action="FullMenu" class="nav-link text-secondary fw-semibold rounded-3 py-2 px-3 text-white-50"><i class="bi bi-journal-text me-2 fs-5 align-middle"></i> Canteen Menu</a>
                </li>
                <li class="nav-item">
                    <a asp-action="Orders" class="nav-link text-secondary fw-semibold rounded-3 py-2 px-3 text-white-50"><i class="bi bi-clock-history me-2 fs-5 align-middle"></i> My Orders</a>
                </li>
                <li class="nav-item">
                    <!-- VAULT LINK WITH VAULT ICON -->
                    <a asp-action="Vault" class="nav-link active bg-danger fw-bold rounded-3 py-2 px-3"><i class="bi bi-safe-fill me-2 fs-5 align-middle"></i> Token Vault</a>
                </li>
                <li class="nav-item">
                    <!-- STATEMENT LINK WITH STATEMENT ICON -->
                    <a asp-action="Statements" class="nav-link text-secondary fw-semibold rounded-3 py-2 px-3 text-white-50"><i class="bi bi-file-earmark-text-fill me-2 fs-5 align-middle"></i> Statement</a>
                </li>
                <li class="nav-item">
                    <a asp-action="Notifications" class="nav-link text-secondary fw-semibold rounded-3 py-2 px-3 text-white-50"><i class="bi bi-bell-fill me-2 fs-5 align-middle"></i> Notifications</a>
                </li>
                <li class="nav-item">
                    <a asp-action="Profile" class="nav-link text-secondary fw-semibold rounded-3 py-2 px-3 text-white-50"><i class="bi bi-person-circle me-2 fs-5 align-middle"></i> Profile</a>
                </li>
            </ul>
        </div>

        <div class="pt-3 border-top border-secondary border-opacity-25">
            <form asp-controller="Account" asp-action="Logout" method="post">
                @Html.AntiForgeryToken()
                <button type="submit" class="btn text-danger w-100 text-start fw-bold p-0 border-0 bg-transparent">
                    <i class="bi bi-box-arrow-left me-2 fs-5 align-middle"></i> Logout
                </button>
            </form>
        </div>
    </div>

    <!-- MAIN SCROLLABLE CONTENT -->
    <div class="admin-main-content">
        <div class="mb-4">
            <h2 class="fw-bold text-dark m-0">Personal Token Vault</h2>
            <p class="text-muted small mt-1 mb-0">Overview of your current Texas Token reserve and overall wallet performance.</p>
        </div>

        <!-- BALANCE CARD BANNER -->
        <div class="card border-0 shadow-sm rounded-4 bg-danger text-white p-4 mb-4">
            <div class="d-flex justify-content-between align-items-center">
                <div>
                    <span class="text-white-50 small fw-bold text-uppercase">Texas Canteen Currency</span>
                    <h1 class="fw-bold text-white m-0 mt-1 display-5"><i class="bi bi-coin me-2"></i>@user?.TokenBalance Tokens</h1>
                    <p class="text-white-50 small m-0 mt-2">Available for food orders across TCMIT Canteen.</p>
                </div>
                <span class="badge bg-white text-danger fw-bold rounded-pill px-4 py-2 fs-6 shadow-sm">
                    <i class="bi bi-check-circle-fill me-1"></i> Active Vault
                </span>
            </div>
        </div>

        <!-- STATS CARDS -->
        <div class="row g-3 mb-4">
            <div class="col-md-6">
                <div class="card border-0 shadow-sm rounded-4 p-4 bg-white">
                    <div class="d-flex align-items-center gap-3">
                        <div class="bg-success-subtle text-success rounded-circle p-3 fs-3">
                            <i class="bi bi-arrow-down-left-circle-fill"></i>
                        </div>
                        <div>
                            <span class="text-muted small fw-bold text-uppercase">Total Top-Ups Received</span>
                            <h3 class="fw-bold text-success m-0">+@ViewBag.TotalReceived Tokens</h3>
                        </div>
                    </div>
                </div>
            </div>
            <div class="col-md-6">
                <div class="card border-0 shadow-sm rounded-4 p-4 bg-white">
                    <div class="d-flex align-items-center gap-3">
                        <div class="bg-danger-subtle text-danger rounded-circle p-3 fs-3">
                            <i class="bi bi-bag-check-fill"></i>
                        </div>
                        <div>
                            <span class="text-muted small fw-bold text-uppercase">Total Meal Expenses</span>
                            <h3 class="fw-bold text-danger m-0">-@ViewBag.TotalSpent Tokens</h3>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- RECENT ACTIVITY PREVIEW -->
        <div class="card border-0 shadow-sm rounded-4 bg-white overflow-hidden w-100 mb-4">
            <div class="p-4 border-bottom d-flex justify-content-between align-items-center">
                <h5 class="fw-bold text-dark m-0">Recent Vault Activity</h5>
                <a asp-action="Statements" class="btn btn-sm btn-outline-danger fw-bold rounded-pill px-3">View Full Statement</a>
            </div>
            <div class="list-group list-group-flush">
                @foreach (var tx in recentActivity)
                {
                    bool isCredit = tx.ReceiverUserId == user?.Id;
                    <div class="list-group-item p-4 border-bottom d-flex justify-content-between align-items-center">
                        <div class="d-flex align-items-center gap-3">
                            <div class="rounded-circle p-3 d-flex align-items-center justify-content-center @(isCredit ? "bg-success-subtle text-success" : "bg-danger-subtle text-danger")">
                                <i class="bi @(isCredit ? "bi-arrow-down-left-circle-fill" : "bi-cart-check-fill") fs-4"></i>
                            </div>
                            <div>
                                <h6 class="fw-bold text-dark m-0">@tx.Description</h6>
                                <span class="text-muted small">@tx.Timestamp.ToString("MMM dd, yyyy - hh:mm tt")</span>
                            </div>
                        </div>
                        <h5 class="fw-bold m-0 @(isCredit ? "text-success" : "text-danger")">
                            @(isCredit ? "+" : "-")@tx.Amount Tokens
                        </h5>
                    </div>
                }
            </div>
        </div>
    </div>
</div>