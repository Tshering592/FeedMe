@model IEnumerable<FeedMe.Models.MenuItem>
@{
    ViewData["Title"] = "Canteen Menu";
    var categories = ViewBag.Categories as List<FeedMe.Models.Category> ?? new();
    int? selectedCategory = ViewBag.SelectedCategory;
}

<div class="mb-4">
    <h2 class="fm-page-title">Canteen Menu</h2>
    <p class="fm-page-subtitle mb-0">Select your favorite food and add it to your order.</p>
</div>

<!-- Search & Category Filters -->
<div class="row g-3 mb-4 align-items-center">
    <div class="col-md-8">
        <div class="d-flex flex-wrap gap-2">
            <a asp-action="Menu" class="fm-filter-pill @(!selectedCategory.HasValue ? "active" : "")">
                All Items
            </a>
            @foreach (var cat in categories)
            {
                <a asp-action="Menu" asp-route-categoryId="@cat.Id" class="fm-filter-pill @(selectedCategory == cat.Id ? "active" : "")">
                    @cat.Name
                </a>
            }
        </div>
    </div>
    <div class="col-md-4">
        <form asp-action="Menu" method="get">
            <div class="fm-search-wrap">
                <input type="text" name="search" class="fm-search-input" placeholder="Search menu..." value="@ViewBag.SearchQuery" aria-label="Search menu" />
                <button class="fm-search-btn" type="submit" aria-label="Search">
                    <i class="bi bi-search"></i>
                </button>
            </div>
        </form>
    </div>
</div>

<!-- Items Grid -->
@if (!Model.Any())
{
    <div class="fm-empty-state">
        <i class="bi bi-egg-fried"></i>
        <h5>No food items found</h5>
        <p>Try selecting a different category or search term.</p>
    </div>
}
else
{
    <div class="row row-cols-1 row-cols-sm-2 row-cols-lg-3 g-4">
        @foreach (var item in Model)
        {
            <div class="col">
                <div class="card h-100 border-0 shadow-sm rounded-4 p-3">
                    <div class="d-flex align-items-center gap-3">
                        <img src="@(string.IsNullOrEmpty(item.ImageUrl) ? "/images/placeholder.jpg" : item.ImageUrl)"
                             alt="@item.Name" loading="lazy" class="rounded-3 flex-shrink-0"
                             style="width: 90px; height: 90px; object-fit: cover;" />
                        <div class="flex-grow-1 overflow-hidden">
                            <span class="badge bg-light text-dark border mb-1" style="font-size: 0.7rem;">@item.Category?.Name</span>
                            <h6 class="fw-bold mb-1">@item.Name</h6>
                            <p class="text-muted small mb-2 text-truncate" style="max-width: 170px;">@item.Description</p>
                            <div class="d-flex justify-content-between align-items-center">
                                <span class="fw-bold text-success">Rs @item.Price.ToString("N2")</span>
                                <button class="btn btn-sm btn-danger rounded-3 fw-semibold">
                                    <i class="bi bi-cart-plus"></i> Order
                                </button>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>
}
