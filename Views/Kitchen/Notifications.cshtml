@model IEnumerable<FeedMe.Models.Notification>
@{
    Layout = null;
    ViewData["Title"] = "Kitchen Notifications";
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - FeedMe</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.0/font/bootstrap-icons.css" />
</head>
<body class="bg-light">

    <partial name="_Header" />

    <div class="container py-4">
        <div class="d-flex justify-content-between align-items-center mb-4">
            <h4 class="fw-bold m-0"><i class="bi bi-bell me-2"></i>Kitchen Notifications</h4>

            <div class="d-flex gap-2 align-items-center">
                <!-- Enable Device Notification Button -->
                <button id="btnEnableNotifications" class="btn btn-primary btn-sm rounded-pill px-3" onclick="requestNotificationPermission()">
                    <i class="bi bi-bell-fill me-1"></i> Enable Notifications
                </button>

                <a href="/Kitchen/Dashboard" class="btn btn-outline-secondary btn-sm rounded-pill px-3">
                    <i class="bi bi-arrow-left me-1"></i> Back to Dashboard
                </a>
            </div>
        </div>

        <div class="card border-0 shadow-sm rounded-4 overflow-hidden">
            <div class="card-body p-0">
                <ul class="list-group list-group-flush">
                    @if (Model != null && Model.Any())
                    {
                        @foreach (var item in Model)
                        {
                            <li class="list-group-item p-3 @(item.IsRead ? "bg-white" : "bg-light")">
                                <div class="d-flex justify-content-between align-items-center">
                                    <div>
                                        <div class="fw-semibold text-dark mb-1">
                                            <i class="bi bi-info-circle text-primary me-2"></i>@item.Message
                                        </div>
                                        <small class="text-muted">
                                            <i class="bi bi-clock me-1"></i>@item.CreatedAt.ToString("f")
                                        </small>
                                    </div>
                                    @if (!item.IsRead)
                                    {
                                        <span class="badge bg-danger rounded-pill">New</span>
                                    }
                                </div>
                            </li>
                        }
                    }
                    else
                    {
                        <li class="list-group-item text-center text-muted py-5">
                            <i class="bi bi-bell-slash fs-2 d-block mb-2"></i>
                            No notifications available.
                        </li>
                    }
                </ul>
            </div>
        </div>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    <script>
            // Check notification status on page load
            document.addEventListener("DOMContentLoaded", () => {
                checkPermissionStatus();
            });

            function checkPermissionStatus() {
                const btn = document.getElementById("btnEnableNotifications");
                if (!("Notification" in window)) {
                    btn.classList.add("disabled");
                    btn.innerText = "Notifications Not Supported";
                    return;
                }

                if (Notification.permission === "granted") {
                    btn.className = "btn btn-success btn-sm rounded-pill px-3";
                    btn.innerHTML = '<i class="bi bi-check-circle-fill me-1"></i> Notifications Enabled';
                } else if (Notification.permission === "denied") {
                    btn.className = "btn btn-danger btn-sm rounded-pill px-3";
                    btn.innerHTML = '<i class="bi bi-x-circle-fill me-1"></i> Notifications Blocked';
                }
            }

            async function requestNotificationPermission() {
                if (!("Notification" in window)) {
                    alert("This browser does not support notifications.");
                    return;
                }

                const permission = await Notification.requestPermission();
                checkPermissionStatus();

                if (permission === "granted") {
                    alert("Device notifications successfully enabled!");
                } else if (permission === "denied") {
                    alert("Notification permission was denied in your browser settings.");
                }
            }
    </script>
</body>
</html>