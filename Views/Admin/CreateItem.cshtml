@model FeedMe.Models.MenuItem
@{
    ViewData["Title"] = "Create Inventory Item";
    Layout = "_AdminLayout";
}

<div class="max-width-700 mx-auto pb-5">
    <div class="mb-4">
        <h3 class="fw-bold m-0">Create Inventory Item</h3>
    </div>

    <div class="card border-0 shadow-sm rounded-4 p-4 bg-white">
        <form asp-action="CreateItem" enctype="multipart/form-data" method="post">
            <div class="mb-3">
                <label asp-for="Name" class="form-label fw-semibold">Name</label>
                <input asp-for="Name" class="form-control rounded-3" placeholder="Enter item name" required />
                <span asp-validation-for="Name" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Description" class="form-label fw-semibold">Description</label>
                <textarea asp-for="Description" class="form-control rounded-3" rows="3" placeholder="Enter item description"></textarea>
            </div>

            <div class="mb-3">
                <label asp-for="CategoryId" class="form-label fw-semibold">Category</label>
                <select asp-for="CategoryId" class="form-select rounded-3" asp-items="@(new SelectList(ViewBag.Categories, "Id", "Name"))" required>
                    <option value="">-- Select Category --</option>
                </select>
                <span asp-validation-for="CategoryId" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Price" class="form-label fw-semibold">Price (Rs)</label>
                <input asp-for="Price" class="form-control rounded-3" type="number" step="0.01" placeholder="0.00" required />
                <span asp-validation-for="Price" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="ImageFile" class="form-label fw-semibold">Item Image</label>
                <input asp-for="ImageFile" class="form-control rounded-3" type="file" accept="image/*" />
                <span asp-validation-for="ImageFile" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="StockQuantity" class="form-label fw-semibold">Stock Quantity</label>
                <input asp-for="StockQuantity" class="form-control rounded-3" placeholder="Leave blank for unlimited" />
            </div>

            <div class="form-check mb-2">
                <input asp-for="IsAvailable" class="form-check-input" />
                <label asp-for="IsAvailable" class="form-check-label fw-semibold">Is Available</label>
            </div>

            <div class="form-check mb-4">
                <input asp-for="IsHotMeal" class="form-check-input" />
                <label asp-for="IsHotMeal" class="form-check-label fw-semibold">Is Hot Meal</label>
            </div>

            <div class="d-flex gap-2">
                <button type="submit" class="btn btn-primary rounded-3 px-4 fw-semibold">Save Item</button>
                <a asp-action="Inventory" class="btn btn-light border rounded-3 px-4">Cancel</a>
            </div>
        </form>
    </div>
</div>