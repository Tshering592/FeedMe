@model IEnumerable<FeedMe.Models.MenuItem>
@{
    ViewData["Title"] = "Menu Management";
    Layout = "_AdminLayout";
    var unpublishedItems = ViewBag.UnpublishedItems as List<FeedMe.Models.MenuItem> ?? new List<FeedMe.Models.MenuItem>();

    // Extract unique category names for category filter pills
    var categories = Model.Select(m => m.Category?.Name).Where(c => !string.IsNullOrEmpty(c)).Distinct().ToList();
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h3 class="fw-bold text-dark m-0">Menu Management</h3>
        <p class="text-muted small m-0">Manage food items, stock availability, and live menu visibility for students.</p>
    </div>
    <button type="button" class="btn btn-primary rounded-pill px-4 fw-semibold shadow-sm" data-bs-toggle="modal" data-bs-target="#pullInventoryModal">
        <i class="bi bi-box-seam me-1"></i> Pull From Inventory (@unpublishedItems.Count)
    </button>
</div>

@if (TempData["Success"] != null)
{
    <div class="alert alert-success alert-dismissible fade show rounded-4 border-0 shadow-sm" role="alert">
        <i class="bi bi-check-circle-fill me-2"></i> @TempData["Success"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

<!-- SEARCH & CATEGORY FILTER BAR -->
<div class="card border-0 shadow-sm rounded-4 bg-white p-3 mb-4">
    <div class="row g-3 align-items-center">
        <!-- Search Input -->
        <div class="col-md-4">
            <div class="position-relative">
                <i class="bi bi-search position-absolute top-50 start-0 translate-middle-y ms-3 text-muted"></i>
                <input type="text" id="menuSearchInput" class="form-control rounded-pill ps-5 pe-4 py-2 border-light bg-light small" placeholder="Search menu items..." />
            </div>
        </div>

        <!-- Category Pills -->
        <div class="col-md-8">
            <div class="d-flex flex-wrap gap-2 justify-content-md-end" id="categoryFilterContainer">
                <button type="button" class="btn btn-sm rounded-pill px-3 fw-semibold category-pill active-pill btn-danger text-white" data-category="all">All</button>
                @foreach (var cat in categories)
                {
                    <button type="button" class="btn btn-sm rounded-pill px-3 fw-semibold category-pill btn-light text-dark border-0" data-category="@cat?.ToLower()">@cat</button>
                }
            </div>
        </div>
    </div>
</div>

<!-- LIVE MENU TABLE -->
<div class="card border-0 shadow-sm rounded-4 bg-white overflow-hidden">
    @if (!Model.Any())
    {
        <div class="p-5 text-center">
            <i class="bi bi-shop fs-1 text-muted d-block mb-2"></i>
            <h6 class="fw-bold text-dark mb-1">No live menu items</h6>
            <p class="text-muted small mb-0">Click <strong>"Pull From Inventory"</strong> above to publish items to the live menu.</p>
        </div>
    }
    else
    {
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0 text-nowrap" id="menuTable">
                <thead class="bg-light border-bottom text-uppercase text-muted" style="font-size: 0.75rem; letter-spacing: 0.5px;">
                    <tr>
                        <th class="ps-4 py-3">Item</th>
                        <th class="py-3">Category</th>
                        <th class="py-3">Price</th>
                        <th class="py-3 text-center">Stock</th>
                        <th class="py-3">Status</th>
                        <th class="pe-4 py-3 text-end">Actions</th>
                    </tr>
                </thead>
                <tbody class="border-top-0">
                    @foreach (var item in Model)
                    {
                        var categoryName = item.Category?.Name ?? "General";
                        <tr class="menu-item-row" data-name="@item.Name.ToLower()" data-category="@categoryName.ToLower()">
                            <!-- ITEM (IMAGE + NAME) -->
                            <td class="ps-4 py-3">
                                <div class="d-flex align-items-center gap-3">
                                    <img src="@(string.IsNullOrEmpty(item.ImageUrl) ? "/images/placeholder.png" : item.ImageUrl)"
                                         class="rounded-3 shadow-sm" style="width: 48px; height: 48px; object-fit: cover;" alt="@item.Name" />
                                    <div>
                                        <div class="fw-bold text-dark">@item.Name</div>
                                        <small class="text-muted d-block text-truncate" style="max-width: 220px;">@item.Description</small>
                                    </div>
                                </div>
                            </td>

                            <!-- CATEGORY -->
                            <td class="py-3">
                                <span class="fw-medium text-dark">@categoryName</span>
                            </td>

                            <!-- PRICE (TOKEN ICON) -->
                            <td class="py-3">
                                <span class="fw-bold text-dark d-inline-flex align-items-center gap-1">
                                    <i class="bi bi-coin text-warning"></i> @item.Price.ToString("N0") Tokens
                                </span>
                            </td>

                            <!-- STOCK -->
                            <td class="py-3 text-center">
                                <span class="badge bg-light text-dark border px-3 py-2 rounded-pill fw-bold">
                                    @(item.StockQuantity.HasValue ? item.StockQuantity.Value.ToString() : "20")
                                </span>
                            </td>

                            <!-- STATUS -->
                            <td class="py-3">
                                <form asp-action="TogglePublish" asp-route-id="@item.Id" method="post" class="d-inline">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="returnUrl" value="@Url.Action("Menu")" />
                                    <button type="submit" class="btn btn-sm border-0 p-0 d-flex align-items-center gap-2" title="Click to Unpublish">
                                        <span class="badge rounded-pill px-3 py-2 fw-bold bg-success-subtle text-success border border-success-subtle">
                                            <i class="bi bi-circle-fill me-1" style="font-size: 0.5rem;"></i> Available
                                        </span>
                                    </button>
                                </form>
                            </td>

                            <!-- ACTIONS -->
                            <td class="pe-4 py-3 text-end">
                                <div class="d-flex justify-content-end gap-1">
                                    <a asp-action="EditItem" asp-route-id="@item.Id" class="btn btn-sm btn-light border rounded-circle p-2 shadow-sm" title="Edit Item">
                                        <i class="bi bi-pencil text-secondary"></i>
                                    </a>
                                    <form asp-action="TogglePublish" asp-route-id="@item.Id" method="post" class="d-inline">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="returnUrl" value="@Url.Action("Menu")" />
                                        <button type="submit" class="btn btn-sm btn-light border rounded-circle p-2 shadow-sm text-danger" title="Unpublish from Menu">
                                            <i class="bi bi-eye-slash"></i>
                                        </button>
                                    </form>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>

<!-- MODAL: Pull Items From Inventory -->
<div class="modal fade" id="pullInventoryModal" tabindex="-1" aria-labelledby="pullInventoryModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-dialog-centered">
        <div class="modal-content border-0 shadow-lg rounded-4">
            <div class="modal-header border-bottom-0 pb-0">
                <h5 class="modal-title fw-bold text-dark" id="pullInventoryModalLabel">Pull Items From Inventory</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body py-4">
                @if (!unpublishedItems.Any())
                {
                    <div class="text-center py-4 text-muted">
                        <i class="bi bi-check-circle-fill fs-1 text-success d-block mb-2"></i>
                        <h6 class="fw-bold text-dark mb-1">All inventory items are published!</h6>
                        <p class="small text-muted mb-0">Every item in your database is currently active on the menu.</p>
                    </div>
                }
                else
                {
                    <!-- Search + Select toggle -->
                    <div class="d-flex flex-wrap gap-2 align-items-center mb-3">
                        <div class="position-relative flex-grow-1">
                            <i class="bi bi-search position-absolute top-50 start-0 translate-middle-y ms-3 text-muted"></i>
                            <input type="text" id="pullSearchInput" class="form-control rounded-pill ps-5"
                                   placeholder="Search inventory items..." autocomplete="off" />
                        </div>
                        <button type="button" id="btnSelectMode" class="btn btn-outline-primary rounded-pill px-4 fw-semibold">
                            <i class="bi bi-check2-square me-1"></i> Select
                        </button>
                    </div>

                    <div class="table-responsive" style="max-height: 55vh; overflow-y: auto;">
                        <table class="table align-middle mb-0">
                            <thead class="bg-light text-uppercase text-muted small sticky-top">
                                <tr>
                                    <th class="select-col ps-3 d-none" style="width: 40px;">
                                        <input type="checkbox" id="chkSelectAll" class="form-check-input" title="Select all shown" />
                                    </th>
                                    <th class="ps-3">Product</th>
                                    <th>Category</th>
                                    <th>Price</th>
                                    <th class="text-end pe-3">Action</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var item in unpublishedItems)
                                {
                                    <tr class="pull-row" data-name="@item.Name.ToLower()">
                                        <td class="select-col ps-3 d-none">
                                            <input type="checkbox" name="selectedIds" value="@item.Id"
                                                   form="bulkPublishForm" class="form-check-input bulk-check" />
                                        </td>
                                        <td class="ps-3">
                                            <div class="d-flex align-items-center gap-2">
                                                @if (string.IsNullOrEmpty(item.ImageUrl))
                                                {
                                                    <div class="rounded-3 bg-light d-flex align-items-center justify-content-center text-muted"
                                                         style="width: 40px; height: 40px;">
                                                        <i class="bi bi-image"></i>
                                                    </div>
                                                }
                                                else
                                                {
                                                    <img src="@item.ImageUrl" class="rounded-3"
                                                         style="width: 40px; height: 40px; object-fit: cover;"
                                                         onerror="this.style.visibility='hidden'" />
                                                }
                                                <strong class="text-dark">@item.Name</strong>
                                            </div>
                                        </td>
                                        <td><span class="badge bg-light text-dark border">@(item.Category?.Name ?? "General")</span></td>
                                        <td class="fw-bold text-dark d-inline-flex align-items-center gap-1">
                                            <i class="bi bi-coin text-warning"></i> @item.Price.ToString("N0") Tokens
                                        </td>
                                        <td class="text-end pe-3">
                                            <form asp-action="TogglePublish" asp-route-id="@item.Id" method="post" class="d-inline single-publish">
                                                @Html.AntiForgeryToken()
                                                <input type="hidden" name="returnUrl" value="@Url.Action("Menu")" />
                                                <button type="submit" class="btn btn-sm btn-success rounded-pill px-3 fw-bold">
                                                    + Publish to Menu
                                                </button>
                                            </form>
                                        </td>
                                    </tr>
                                }
                                <tr id="pullNoResults" class="d-none">
                                    <td colspan="5" class="text-center text-muted py-4">No items match your search.</td>
                                </tr>
                            </tbody>
                        </table>
                    </div>
                }
            </div>

            @if (unpublishedItems.Any())
            {
                <!-- Bulk publish bar (shown only when items are ticked) -->
                <div id="bulkBar" class="modal-footer border-top d-none justify-content-between">
                    <span class="text-muted small"><strong id="selectedCount">0</strong> selected</span>
                    <div class="d-flex gap-2">
                        <button type="button" id="btnClearSel" class="btn btn-light rounded-pill px-3">Clear</button>
                        <form id="bulkPublishForm" asp-action="PublishMultiple" method="post" class="d-inline">
                            <button type="submit" class="btn btn-success rounded-pill px-4 fw-bold">
                                <i class="bi bi-cloud-upload me-1"></i> Publish Selected
                            </button>
                        </form>
                    </div>
                </div>
            }
        </div>
    </div>
</div>

@section Scripts {
    <script>
        document.addEventListener("DOMContentLoaded", function() {
            const searchInput = document.getElementById("menuSearchInput");
            const categoryPills = document.querySelectorAll(".category-pill");
            const rows = document.querySelectorAll(".menu-item-row");

            let activeCategory = "all";

            function filterMenu() {
                const query = searchInput ? searchInput.value.toLowerCase().trim() : "";

                rows.forEach(row => {
                    const name = row.getAttribute("data-name") || "";
                    const category = row.getAttribute("data-category") || "";

                    const matchesSearch = name.includes(query);
                    const matchesCategory = (activeCategory === "all") || (category === activeCategory);

                    if (matchesSearch && matchesCategory) {
                        row.style.display = "";
                    } else {
                        row.style.display = "none";
                    }
                });
            }

            if (searchInput) {
                searchInput.addEventListener("input", filterMenu);
            }

            categoryPills.forEach(pill => {
                pill.addEventListener("click", function() {
                    categoryPills.forEach(p => {
                        p.classList.remove("btn-danger", "text-white", "active-pill");
                        p.classList.add("btn-light", "text-dark");
                    });

                    this.classList.remove("btn-light", "text-dark");
                    this.classList.add("btn-danger", "text-white", "active-pill");

                    activeCategory = this.getAttribute("data-category");
                    filterMenu();
                });
            });
        });
    </script>
    <script>
        document.addEventListener("DOMContentLoaded", function () {
            const modalEl = document.getElementById("pullInventoryModal");
            const searchInput = document.getElementById("pullSearchInput");
            if (!modalEl || !searchInput) return;

            const btnSelectMode = document.getElementById("btnSelectMode");
            const btnClear = document.getElementById("btnClearSel");
            const chkAll = document.getElementById("chkSelectAll");
            const bulkBar = document.getElementById("bulkBar");
            const countEl = document.getElementById("selectedCount");
            const noResults = document.getElementById("pullNoResults");
            const rows = modalEl.querySelectorAll(".pull-row");
            const checks = modalEl.querySelectorAll(".bulk-check");
            const selectCols = modalEl.querySelectorAll(".select-col");
            const singleForms = modalEl.querySelectorAll(".single-publish");

            let selectMode = false;

            function visibleRows() {
                return Array.from(rows).filter(r => r.style.display !== "none");
            }

            function updateBar() {
                const n = Array.from(checks).filter(c => c.checked).length;
                countEl.textContent = n;
                bulkBar.classList.toggle("d-none", !(selectMode && n > 0));
                bulkBar.classList.toggle("d-flex", selectMode && n > 0);

                const vis = visibleRows();
                chkAll.checked = vis.length > 0 &&
                    vis.every(r => r.querySelector(".bulk-check").checked);
            }

            function filterRows() {
                const q = searchInput.value.toLowerCase().trim();
                let shown = 0;
                rows.forEach(r => {
                    const match = (r.dataset.name || "").includes(q);
                    r.style.display = match ? "" : "none";
                    if (match) shown++;
                });
                noResults.classList.toggle("d-none", shown > 0);
                updateBar();
            }

            function setSelectMode(on) {
                selectMode = on;
                selectCols.forEach(c => c.classList.toggle("d-none", !on));
                singleForms.forEach(f => f.classList.toggle("d-none", on));
                btnSelectMode.classList.toggle("btn-primary", on);
                btnSelectMode.classList.toggle("btn-outline-primary", !on);
                btnSelectMode.innerHTML = on
                    ? '<i class="bi bi-x-lg me-1"></i> Cancel'
                    : '<i class="bi bi-check2-square me-1"></i> Select';
                if (!on) checks.forEach(c => c.checked = false);
                updateBar();
            }

            searchInput.addEventListener("input", filterRows);
            btnSelectMode.addEventListener("click", () => setSelectMode(!selectMode));
            btnClear.addEventListener("click", () => { checks.forEach(c => c.checked = false); updateBar(); });
            checks.forEach(c => c.addEventListener("change", updateBar));

            // "Select all" only ticks the rows currently shown by the search
            chkAll.addEventListener("change", function () {
                visibleRows().forEach(r => r.querySelector(".bulk-check").checked = chkAll.checked);
                updateBar();
            });

            // In select mode, clicking anywhere on a row toggles its checkbox
            rows.forEach(r => r.addEventListener("click", function (e) {
                if (!selectMode || e.target.closest("button, a")) return;
                const cb = r.querySelector(".bulk-check");
                if (e.target !== cb) cb.checked = !cb.checked;
                updateBar();
            }));

            modalEl.addEventListener("shown.bs.modal", () => searchInput.focus());
            modalEl.addEventListener("hidden.bs.modal", function () {
                searchInput.value = "";
                filterRows();
                setSelectMode(false);
            });
        });
    </script>
}