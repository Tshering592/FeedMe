@using FeedMe.Models
@model List<TokenTransaction>
@{
    ViewData["Title"] = "Token Transactions Audit - Admin";
}

<style>
    header, footer, nav.navbar, .navbar {
        display: none !important;
    }

    html, body {
        background-color: #f8fafc !important;
        margin: 0 !important;
        padding: 0 !important;
        height: 100vh !important;
        overflow: hidden !important;
    }

    .admin-sidebar {
        width: 250px;
        height: 100vh;
        position: fixed;
        top: 0;
        left: 0;
        background-color: #0f172a;
        z-index: 1000;
    }

    .admin-main-content {
        position: fixed !important;
        top: 0 !important;
        left: 250px !important;
        right: 0 !important;
        bottom: 0 !important;
        height: 100vh !important;
        overflow-y: auto !important;
        padding: 32px 40px !important;
        box-sizing: border-box !important;
        background-color: #f8fafc !important;
    }
</style>

<div class="d-flex">
    <!-- ADMIN SIDEBAR -->
    <div class="admin-sidebar text-white p-3 d-flex flex-column justify-content-between">
        <div>
            <div class="d-flex align-items-center gap-3 mb-4 pb-3 border-bottom border-secondary border-opacity-25">
                <div class="bg-danger rounded-circle p-2 d-flex align-items-center justify-content-center shadow-sm" style="width: 42px; height: 42px; min-width: 42px;">
                    <i class="bi bi-cup-hot-fill text-white fs-5"></i>
                </div>
                <div class="text-truncate">
                    <h6 class="fw-bold m-0 text-white text-truncate" style="font-size: 0.95rem;">TCMIT CANTEEN</h6>
                    <span class="text-danger small fw-semibold" style="font-size: 0.75rem;">Admin Portal</span>
                </div>
            </div>

            <ul class="nav nav-pills flex-column gap-2">
                <li class="nav-item">
                    <a asp-action="Dashboard" class="nav-link text-secondary fw-semibold rounded-3 py-2 px-3 text-white-50"><i class="bi bi-grid-fill me-2 fs-5 align-middle"></i> Dashboard</a>
                </li>
                <li class="nav-item">
                    <a asp-action="Inventory" class="nav-link text-secondary fw-semibold rounded-3 py-2 px-3 text-white-50"><i class="bi bi-box-seam me-2 fs-5 align-middle"></i> Inventory</a>
                </li>
                <li class="nav-item">
                    <a asp-action="MenuManagement" class="nav-link text-secondary fw-semibold rounded-3 py-2 px-3 text-white-50"><i class="bi bi-list-task me-2 fs-5 align-middle"></i> Menu Management</a>
                </li>
                <li class="nav-item">
                    <a asp-action="Orders" class="nav-link text-secondary fw-semibold rounded-3 py-2 px-3 text-white-50"><i class="bi bi-card-checklist me-2 fs-5 align-middle"></i> Orders</a>
                </li>
                <li class="nav-item">
                    <a asp-action="TimeSlots" class="nav-link text-secondary fw-semibold rounded-3 py-2 px-3 text-white-50"><i class="bi bi-clock me-2 fs-5 align-middle"></i> Time Slots</a>
                </li>
                <li class="nav-item">
                    <a asp-action="Users" class="nav-link text-secondary fw-semibold rounded-3 py-2 px-3 text-white-50"><i class="bi bi-people-fill me-2 fs-5 align-middle"></i> Users</a>
                </li>
                <li class="nav-item">
                    <a asp-action="Transactions" class="nav-link active bg-danger fw-bold rounded-3 py-2 px-3"><i class="bi bi-receipt me-2 fs-5 align-middle"></i> Transactions</a>
                </li>
            </ul>
        </div>

        <div class="pt-3 border-top border-secondary border-opacity-25">
            <form asp-controller="Account" asp-action="Logout" method="post">
                @Html.AntiForgeryToken()
                <button type="submit" class="btn text-danger w-100 text-start fw-bold p-0 border-0 bg-transparent">
                    <i class="bi bi-box-arrow-left me-2 fs-5 align-middle"></i> Logout
                </button>
            </form>
        </div>
    </div>

    <!-- MAIN CONTENT -->
    <div class="admin-main-content">
        <div class="mb-4">
            <h2 class="fw-bold text-dark m-0">Token Transaction Audit Logs</h2>
            <p class="text-muted small mt-1 mb-0">System-wide ledger of Texas Token transfers, top-ups, and meal payments.</p>
        </div>

        <div class="card border-0 shadow-sm rounded-4 bg-white overflow-hidden w-100 mb-4">
            @if (Model == null || !Model.Any())
            {
                <div class="p-5 text-center">
                    <i class="bi bi-receipt fs-1 text-muted d-block mb-2"></i>
                    <h6 class="fw-bold text-dark m-0">No transactions recorded yet</h6>
                </div>
            }
            else
            {
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0 w-100">
                        <thead class="bg-light border-bottom text-uppercase text-muted" style="font-size: 0.75rem;">
                            <tr>
                                <th class="ps-4 py-3">Tx ID</th>
                                <th class="py-3">Timestamp</th>
                                <th class="py-3">Sender</th>
                                <th class="py-3">Recipient</th>
                                <th class="py-3">Type</th>
                                <th class="py-3">Description</th>
                                <th class="pe-4 py-3 text-end">Amount</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var tx in Model)
                            {
                                <tr>
                                    <td class="ps-4 py-3 fw-bold text-dark">#TX-@tx.Id.ToString("D5")</td>
                                    <td class="py-3 small text-muted">@tx.Timestamp.ToString("yyyy-MM-dd HH:mm")</td>
                                    <td class="py-3 small fw-semibold text-dark">@tx.SenderName</td>
                                    <td class="py-3 small fw-semibold text-dark">@tx.ReceiverName</td>
                                    <td class="py-3">
                                        <span class="badge rounded-pill px-3 py-2 fw-bold @(tx.Type == TransactionType.TopUp ? "bg-success-subtle text-success" : "bg-primary-subtle text-primary")">
                                            @tx.Type
                                        </span>
                                    </td>
                                    <td class="py-3 small text-muted">@tx.Description</td>
                                    <td class="pe-4 py-3 text-end fw-bold @(tx.Type == TransactionType.TopUp ? "text-success" : "text-danger")">
                                        @(tx.Type == TransactionType.TopUp ? "+" : "-")@tx.Amount Tokens
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>
    </div>
</div>