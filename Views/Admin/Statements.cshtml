@using FeedMe.Models
@model List<TokenTransaction>
@{
    ViewData["Title"] = "Transaction Statements - Admin";
    var currentAction = ViewContext.RouteData.Values["action"]?.ToString() ?? "";
}

<style>
    header, footer, nav.navbar, .navbar {
        display: none !important;
    }

    html, body {
        background-color: #f8fafc !important;
        margin: 0 !important;
        padding: 0 !important;
        height: 100vh !important;
        overflow: hidden !important;
    }

    .admin-sidebar {
        width: 250px;
        height: 100vh;
        position: fixed;
        top: 0;
        left: 0;
        background-color: #0f172a;
        z-index: 1000;
    }

    .admin-main-content {
        position: fixed !important;
        top: 0 !important;
        left: 0 !important;
        right: 0 !important;
        bottom: 0 !important;
        height: 100vh !important;
        overflow-y: auto !important;
        padding: 32px 40px !important;
        box-sizing: border-box;
    }
</style>

<div class="d-flex">
    <!-- SIDEBAR -->
    <div class="admin-sidebar text-white p-3 d-flex flex-column justify-content-between">
        <div>
            <div class="d-flex align-items-center gap-3 mb-4 pb-3 border-bottom border-secondary border-opacity-25">
                <div class="bg-danger rounded-circle p-2 d-flex align-items-center justify-content-center shadow-sm" style="width: 42px; height: 42px; min-width: 42px;">
                    <i class="bi bi-cup-hot-fill text-white fs-5"></i>
                </div>
                <div class="text-truncate">
                    <h6 class="fw-bold m-0 text-white text-truncate" style="font-size: 0.95rem;">TCMIT CANTEEN</h6>
                    <span class="text-danger small fw-semibold" style="font-size: 0.75rem;">Admin Portal</span>
                </div>
            </div>

            <ul class="nav nav-pills flex-column gap-2">
                <li class="nav-item">
                    <a asp-action="Dashboard" class="nav-link @(currentAction == "Dashboard" ? "active bg-danger text-white fw-bold" : "text-white-50 fw-semibold") rounded-3 py-2 px-3">
                        <i class="bi bi-grid-fill me-2 fs-5 align-middle"></i> Dashboard
                    </a>
                </li>
                <li class="nav-item">
                    <a asp-action="Vault" class="nav-link @(currentAction == "Vault" ? "active bg-danger text-white fw-bold" : "text-white-50 fw-semibold") rounded-3 py-2 px-3">
                        <i class="bi bi-safe2-fill me-2 fs-5 align-middle"></i> Token Vault
                    </a>
                </li>
                <li class="nav-item">
                    <a asp-action="Statements" class="nav-link @(currentAction == "Statements" ? "active bg-danger text-white fw-bold" : "text-white-50 fw-semibold") rounded-3 py-2 px-3">
                        <i class="bi bi-file-earmark-text-fill me-2 fs-5 align-middle"></i> Statements
                    </a>
                </li>
                <li class="nav-item">
                    <a asp-action="Inventory" class="nav-link @(currentAction == "Inventory" ? "active bg-danger text-white fw-bold" : "text-white-50 fw-semibold") rounded-3 py-2 px-3">
                        <i class="bi bi-box-seam-fill me-2 fs-5 align-middle"></i> Inventory
                    </a>
                </li>
                <li class="nav-item">
                    <a asp-action="Menu" class="nav-link @(currentAction == "Menu" ? "active bg-danger text-white fw-bold" : "text-white-50 fw-semibold") rounded-3 py-2 px-3">
                        <i class="bi bi-journal-text me-2 fs-5 align-middle"></i> Menu Management
                    </a>
                </li>
                <li class="nav-item">
                    <a asp-action="Orders" class="nav-link @(currentAction == "Orders" ? "active bg-danger text-white fw-bold" : "text-white-50 fw-semibold") rounded-3 py-2 px-3">
                        <i class="bi bi-cart-check-fill me-2 fs-5 align-middle"></i> Orders
                    </a>
                </li>
                <li class="nav-item">
                    <a asp-action="Slots" class="nav-link @(currentAction == "Slots" ? "active bg-danger text-white fw-bold" : "text-white-50 fw-semibold") rounded-3 py-2 px-3">
                        <i class="bi bi-clock-fill me-2 fs-5 align-middle"></i> Time Slots
                    </a>
                </li>
                <li class="nav-item">
                    <a asp-action="Users" class="nav-link @(currentAction == "Users" ? "active bg-danger text-white fw-bold" : "text-white-50 fw-semibold") rounded-3 py-2 px-3">
                        <i class="bi bi-people-fill me-2 fs-5 align-middle"></i> Users
                    </a>
                </li>
            </ul>
        </div>

        <div class="pt-3 border-top border-secondary border-opacity-25">
            <form asp-controller="Account" asp-action="Logout" method="post">
                @Html.AntiForgeryToken()
                <button type="submit" class="btn text-danger w-100 text-start fw-bold p-0 border-0 bg-transparent">
                    <i class="bi bi-box-arrow-left me-2 fs-5 align-middle"></i> Logout
                </button>
            </form>
        </div>
    </div>

    <!-- MAIN CONTENT -->
    <div class="admin-main-content">
        <div class="d-flex justify-content-between align-items-center mb-4">
            <div>
                <h3 class="fw-bold text-dark m-0">Token Transaction Statements</h3>
                <p class="text-muted small m-0">Monitor daily volume, analyze past monthly statements, and download audit reports.</p>
            </div>
            <a asp-action="ExportTransactionsCsv" asp-route-viewType="@ViewBag.ViewType" asp-route-selectedMonth="@ViewBag.SelectedMonth" asp-route-selectedYear="@ViewBag.SelectedYear" class="btn btn-outline-danger fw-bold rounded-3 px-3 py-2">
                <i class="bi bi-download me-1"></i> Download Statement (.CSV)
            </a>
        </div>

        <!-- STAT CARDS -->
        <div class="row g-3 mb-4">
            <div class="col-md-4">
                <div class="card border-0 shadow-sm rounded-4 p-4 bg-white h-100">
                    <span class="text-muted small fw-bold text-uppercase">Today's Meal Token Volume</span>
                    <h3 class="fw-bold text-dark m-0 mt-1"><i class="bi bi-coin text-warning me-2"></i>@ViewBag.TodaysVolume.ToString("F2") Tokens</h3>
                    <span class="text-muted small mt-2">@ViewBag.TodaysTxCount transactions recorded today</span>
                </div>
            </div>
            <div class="col-md-4">
                <div class="card border-0 shadow-sm rounded-4 p-4 bg-white h-100">
                    <span class="text-muted small fw-bold text-uppercase">Total Circulation Volume</span>
                    <h3 class="fw-bold text-primary m-0 mt-1"><i class="bi bi-graph-up-arrow me-2"></i>@ViewBag.TotalCirculatingVolume.ToString("F2") Tokens</h3>
                    <span class="text-muted small mt-2">Circulating in student/staff wallets</span>
                </div>
            </div>
            <div class="col-md-4">
                <div class="card border-0 shadow-sm rounded-4 p-4 bg-white h-100">
                    <span class="text-muted small fw-bold text-uppercase">Statement Filter Mode</span>
                    <h3 class="fw-bold text-danger m-0 mt-1"><i class="bi bi-funnel-fill me-2"></i>@(ViewBag.ViewType == "month" ? "Monthly View" : ViewBag.ViewType == "all" ? "All-Time" : "Today View")</h3>
                    <span class="text-muted small mt-2">Showing filtered ledger records</span>
                </div>
            </div>
        </div>

        <!-- FILTER TOOLBAR -->
        <div class="card border-0 shadow-sm rounded-4 bg-white p-3 mb-4">
            <form method="get" asp-action="Statements" class="d-flex flex-wrap align-items-center justify-content-between gap-3">
                <div class="btn-group" role="group">
                    <a asp-action="Statements" asp-route-viewType="today" class="btn @(ViewBag.ViewType == "today" ? "btn-danger fw-bold" : "btn-light text-secondary fw-semibold") rounded-start-3">
                        <i class="bi bi-calendar-event me-1"></i> Today's Transactions
                    </a>
                    <a asp-action="Statements" asp-route-viewType="all" class="btn @(ViewBag.ViewType == "all" ? "btn-danger fw-bold" : "btn-light text-secondary fw-semibold") rounded-end-3">
                        <i class="bi bi-list-task me-1"></i> All-Time Ledger
                    </a>
                </div>

                <div class="d-flex align-items-center gap-2">
                    <input type="hidden" name="viewType" value="month" />
                    <select name="selectedMonth" class="form-select rounded-3 border-light bg-light fw-semibold text-secondary" style="width: 130px;">
                        @for (int m = 1; m <= 12; m++)
                        {
                            <option value="@m" selected="@(m == ViewBag.SelectedMonth)">@System.Globalization.CultureInfo.CurrentCulture.DateTimeFormat.GetMonthName(m)</option>
                        }
                    </select>
                    <select name="selectedYear" class="form-select rounded-3 border-light bg-light fw-semibold text-secondary" style="width: 100px;">
                        @for (int y = DateTime.Today.Year; y >= 2024; y--)
                        {
                            <option value="@y" selected="@(y == ViewBag.SelectedYear)">@y</option>
                        }
                    </select>
                    <button type="submit" class="btn btn-dark fw-bold rounded-3 px-3">Filter</button>
                </div>
            </form>
        </div>

        <!-- TRANSACTIONS TABLE -->
        <div class="card border-0 shadow-sm rounded-4 bg-white overflow-hidden mb-4">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0" id="statementTable">
                    <thead class="bg-light text-uppercase text-muted small border-bottom">
                        <tr>
                            <th class="ps-4 py-3">TX ID</th>
                            <th class="py-3">Timestamp</th>
                            <th class="py-3">Sender</th>
                            <th class="py-3">Recipient</th>
                            <th class="py-3">Type</th>
                            <th class="py-3">Description</th>
                            <th class="pe-4 py-3 text-end">Amount</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model == null || !Model.Any())
                        {
                            <tr>
                                <td colspan="7" class="text-center py-5 text-muted">
                                    <i class="bi bi-receipt fs-1 d-block mb-2 text-muted opacity-50"></i>
                                    No transaction records found for this filter.
                                </td>
                            </tr>
                        }
                        else
                        {
                            foreach (var tx in Model)
                            {
                                bool isVaultOutflow = tx.Type == TransactionType.TopUp || tx.Type == TransactionType.Refund;
                                <tr class="tx-row">
                                    <td class="ps-4 fw-bold text-dark">#TX-@tx.Id.ToString("D5")</td>
                                    <td class="text-muted small">@tx.Timestamp.ToString("yyyy-MM-dd HH:mm")</td>
                                    <td class="fw-semibold text-dark">@tx.SenderName</td>
                                    <td class="fw-semibold text-dark">@tx.ReceiverName</td>
                                    <td>
                                        <span class="badge @(isVaultOutflow ? "bg-danger-subtle text-danger" : "bg-success-subtle text-success") rounded-pill px-3 py-1 fw-bold">
                                            @tx.Type
                                        </span>
                                    </td>
                                    <td class="text-muted small text-truncate" style="max-width: 280px;">@tx.Description</td>
                                    <td class="pe-4 text-end">
                                        @if (isVaultOutflow)
                                        {
                                            <span class="fw-bold text-danger">-@tx.Amount.ToString("F2") Tokens</span>
                                        }
                                        else
                                        {
                                            <span class="fw-bold text-success">+@tx.Amount.ToString("F2") Tokens</span>
                                        }
                                    </td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>

            <!-- PAGINATION CONTROLS (10 Records Per Page) -->
            @if (Model != null && Model.Count > 10)
            {
                <div class="d-flex justify-content-between align-items-center p-3 border-top bg-light">
                    <span class="text-muted small fw-semibold" id="paginationInfo">Showing 1 to 10 of @Model.Count transactions</span>
                    <div class="btn-group">
                        <button type="button" class="btn btn-outline-secondary btn-sm fw-bold rounded-start-3" id="prevBtn" onclick="prevPage()">
                            <i class="bi bi-chevron-left me-1"></i> Previous
                        </button>
                        <button type="button" class="btn btn-outline-secondary btn-sm fw-bold rounded-end-3" id="nextBtn" onclick="nextPage()">
                            Next <i class="bi bi-chevron-right ms-1"></i>
                        </button>
                    </div>
                </div>
            }
        </div>
    </div>
</div>

<!-- CLIENT-SIDE PAGINATION SCRIPT -->
<script>
    let currentPage = 1;
    const recordsPerPage = 10;
    const rows = document.querySelectorAll('.tx-row');
    const totalRows = rows.length;
    const totalPages = Math.ceil(totalRows / recordsPerPage);

    function displayPage(page) {
        if (totalRows === 0) return;

        currentPage = page;
        const start = (page - 1) * recordsPerPage;
        const end = start + recordsPerPage;

        rows.forEach((row, index) => {
            if (index >= start && index < end) {
                row.style.display = '';
            } else {
                row.style.display = 'none';
            }
        });

        const infoElem = document.getElementById('paginationInfo');
        if (infoElem) {
            const currentEnd = Math.min(end, totalRows);
            infoElem.innerText = `Showing ${start + 1} to ${currentEnd} of ${totalRows} transactions`;
        }

        const prevBtn = document.getElementById('prevBtn');
        const nextBtn = document.getElementById('nextBtn');
        if (prevBtn) prevBtn.disabled = (currentPage === 1);
        if (nextBtn) nextBtn.disabled = (currentPage === totalPages || totalPages === 0);
    }

    function prevPage() {
        if (currentPage > 1) {
            displayPage(currentPage - 1);
        }
    }

    function nextPage() {
        if (currentPage < totalPages) {
            displayPage(currentPage + 1);
        }
    }

    document.addEventListener('DOMContentLoaded', () => {
        if (totalRows > 0) {
            displayPage(1);
        }
    });
</script>