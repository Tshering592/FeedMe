@model IEnumerable<FeedMe.Models.TimeSlot>
@{
    ViewData["Title"] = "Time Slots Management";
    Layout = "_AdminLayout";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h3 class="fw-bold text-dark m-0">Time Slots</h3>
        <p class="text-muted small m-0">Set pickup time slots for student food ordering.</p>
    </div>
    <a asp-action="CreateSlot" class="btn btn-primary rounded-pill px-4 fw-bold shadow-sm">
        <i class="bi bi-plus-lg me-1"></i> Add New Slot
    </a>
</div>

@if (TempData["Success"] != null)
{
    <div class="alert alert-success alert-dismissible fade show rounded-4 border-0 shadow-sm" role="alert">
        <i class="bi bi-check-circle-fill me-2"></i> @TempData["Success"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

<div class="card border-0 shadow-sm rounded-4 bg-white overflow-hidden">
    @if (!Model.Any())
    {
        <div class="p-5 text-center">
            <i class="bi bi-clock-history fs-1 text-muted d-block mb-2"></i>
            <h6 class="fw-bold text-dark mb-1">No time slots created</h6>
            <p class="text-muted small mb-0">Click <strong>"Add New Slot"</strong> above to configure pickup time slots.</p>
        </div>
    }
    else
    {
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0 text-nowrap">
                <thead class="bg-light border-bottom text-uppercase text-muted" style="font-size: 0.75rem; letter-spacing: 0.5px;">
                    <tr>
                        <th class="ps-4 py-3">Slot Time Interval</th>
                        <th class="py-3 text-center">Total Orders Placed</th>
                        <th class="py-3 text-center">Capacity</th>
                        <th class="py-3">Status</th>
                        <th class="pe-4 py-3 text-end">Actions</th>
                    </tr>
                </thead>
                <tbody class="border-top-0">
                    @foreach (var slot in Model)
                    {
                        int currentOrdersCount = slot.Orders?.Count ?? 0;

                        <tr>
                            <!-- START & END TIME -->
                            <td class="ps-4 py-3">
                                <div class="fw-bold text-dark fs-6">
                                    <i class="bi bi-clock me-2 text-danger"></i> @slot.StartTime.ToString("MMM dd, hh:mm tt") - @slot.EndTime.ToString("hh:mm tt")
                                </div>
                            </td>

                            <!-- TOTAL ORDERS -->
                            <td class="py-3 text-center">
                                <span class="badge bg-light text-dark border px-3 py-2 rounded-pill fw-bold">
                                    @currentOrdersCount @(currentOrdersCount == 1 ? "order" : "orders")
                                </span>
                            </td>

                            <!-- UNLIMITED CAPACITY BADGE -->
                            <td class="py-3 text-center">
                                <span class="badge bg-info-subtle text-info-emphasis border border-info-subtle px-3 py-2 rounded-pill fw-bold">
                                    <i class="bi bi-infinity me-1"></i> Unlimited
                                </span>
                            </td>

                            <!-- STATUS BADGE -->
                            <td class="py-3">
                                @if (slot.IsActive)
                                {
                                    <span class="badge rounded-pill px-3 py-2 fw-bold bg-success-subtle text-success border border-success-subtle">
                                        <i class="bi bi-circle-fill me-1" style="font-size: 0.5rem;"></i> Active
                                    </span>
                                }
                                else
                                {
                                    <span class="badge rounded-pill px-3 py-2 fw-bold bg-secondary-subtle text-secondary border border-secondary-subtle">
                                        Inactive
                                    </span>
                                }
                            </td>

                            <!-- ACTIONS -->
                            <td class="pe-4 py-3 text-end">
                                <div class="d-flex justify-content-end gap-2">
                                    <form asp-action="ToggleSlotStatus" asp-route-id="@slot.Id" method="post" class="d-inline">
                                        @Html.AntiForgeryToken()
                                        <button type="submit" class="btn btn-sm @(slot.IsActive ? "btn-outline-warning" : "btn-outline-success") rounded-pill px-3 fw-semibold">
                                            @(slot.IsActive ? "Deactivate" : "Activate")
                                        </button>
                                    </form>

                                    <form asp-action="DeleteSlot" asp-route-id="@slot.Id" method="post" class="d-inline" onsubmit="return confirm('Are you sure you want to delete this slot?');">
                                        @Html.AntiForgeryToken()
                                        <button type="submit" class="btn btn-sm btn-light border rounded-circle p-2 shadow-sm text-danger" title="Delete Slot">
                                            <i class="bi bi-trash"></i>
                                        </button>
                                    </form>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>