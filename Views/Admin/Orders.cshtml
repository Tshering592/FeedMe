@using FeedMe.Models
@model IEnumerable<FeedMe.Models.Order>
@{
    ViewData["Title"] = "Order Management";
    Layout = "_AdminLayout";
    string selectedFilter = ViewBag.SelectedFilter as string ?? "Active";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h3 class="fw-bold text-dark m-0">Order Management</h3>
        <p class="text-muted small m-0">Manage live canteen orders and update pickup status in real-time.</p>
    </div>
</div>

@if (TempData["Success"] != null)
{
    <div class="alert alert-success alert-dismissible fade show rounded-4 border-0 shadow-sm" role="alert">
        <i class="bi bi-check-circle-fill me-2"></i> @TempData["Success"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

<!-- SEARCH BAR & TABS -->
<div class="card border-0 shadow-sm rounded-4 bg-white p-3 mb-4">
    <div class="row g-3 align-items-center">
        <!-- Search Input -->
        <div class="col-md-6">
            <form method="get" asp-action="Orders" class="position-relative">
                <input type="hidden" name="statusFilter" value="@selectedFilter" />
                <i class="bi bi-search position-absolute top-50 start-0 translate-middle-y ms-3 text-muted"></i>
                <input type="text" name="searchString" value="@ViewBag.SearchString" class="form-control rounded-pill ps-5 pe-4 py-2 border-light bg-light small" placeholder="Search by token, student, or college ID..." onchange="this.form.submit()" />
            </form>
        </div>

        <!-- Filter Tabs -->
        <div class="col-md-6 text-md-end">
            <div class="btn-group rounded-pill overflow-hidden border bg-light p-1" role="group">
                <a asp-action="Orders" asp-route-statusFilter="Active"
                   class="btn btn-sm rounded-pill border-0 px-3 fw-semibold @(selectedFilter == "Active" ? "btn-dark text-white shadow-sm" : "btn-light text-muted")">Active Queue</a>
                <a asp-action="Orders" asp-route-statusFilter="Ready"
                   class="btn btn-sm rounded-pill border-0 px-3 fw-semibold @(selectedFilter == "Ready" ? "btn-success text-white shadow-sm" : "btn-light text-muted")">Ready</a>
                <a asp-action="Orders" asp-route-statusFilter="Completed"
                   class="btn btn-sm rounded-pill border-0 px-3 fw-semibold @(selectedFilter == "Completed" ? "btn-secondary text-white shadow-sm" : "btn-light text-muted")">Completed</a>
                <a asp-action="Orders" asp-route-statusFilter="Cancelled"
                   class="btn btn-sm rounded-pill border-0 px-3 fw-semibold @(selectedFilter == "Cancelled" ? "btn-danger text-white shadow-sm" : "btn-light text-muted")">Cancelled</a>
            </div>
        </div>
    </div>
</div>

<!-- ORDERS TABLE -->
<div class="card border-0 shadow-sm rounded-4 bg-white overflow-hidden">
    @if (!Model.Any())
    {
        <div class="p-5 text-center">
            <i class="bi bi-inbox fs-1 text-muted d-block mb-2"></i>
            <h6 class="fw-bold text-dark mb-1">No orders found in @selectedFilter</h6>
            <p class="text-muted small mb-0">Orders placed by students via the app will show up here automatically.</p>
        </div>
    }
    else
    {
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0 text-nowrap">
                <thead class="bg-light border-bottom text-uppercase text-muted" style="font-size: 0.75rem; letter-spacing: 0.5px;">
                    <tr>
                        <th class="ps-4 py-3">Token</th>
                        <th class="py-3">Student</th>
                        <th class="py-3">Placed On</th>
                        <th class="py-3">Pickup Time</th>
                        <th class="py-3 text-center">Items</th>
                        <th class="py-3">Amount</th>
                        <th class="py-3">Status</th>
                        <th class="pe-4 py-3 text-end">Actions</th>
                    </tr>
                </thead>
                <tbody class="border-top-0">
                    @foreach (var order in Model)
                    {
                        var statusStr = order.Status.ToString();
                        int totalItemsCount = order.OrderItems.Sum(i => i.Quantity);

                        string statusClass = statusStr switch
                        {
                            "Ready" => "bg-success-subtle text-success border border-success-subtle",
                            "Preparing" => "bg-warning-subtle text-warning-emphasis border border-warning-subtle",
                            "Pending" => "bg-warning-subtle text-warning-emphasis border border-warning-subtle",
                            "Completed" => "bg-secondary-subtle text-secondary border border-secondary-subtle",
                            "Cancelled" => "bg-danger-subtle text-danger border border-danger-subtle",
                            _ => "bg-light text-dark"
                        };

                        <tr>
                            <!-- TOKEN -->
                            <td class="ps-4 py-3">
                                <span class="fw-bold fs-5 text-danger">#@order.Id.ToString("D3")</span>
                            </td>

                            <!-- STUDENT DETAILS -->
                            <td class="py-3">
                                <div class="fw-bold text-dark">@(string.IsNullOrEmpty(order.StudentName) ? "Student User" : order.StudentName)</div>
                                <div class="text-muted small" style="font-size: 0.8rem;">
                                    TCMIT/@(string.IsNullOrEmpty(order.StudentLcid) ? "STD" : order.StudentLcid)
                                    @if (!string.IsNullOrEmpty(order.Semester))
                                    {
                                        <span> • Sem @order.Semester</span>
                                    }
                                </div>
                            </td>

                            <!-- PLACED ON -->
                            <td class="py-3">
                                <div class="text-dark fw-medium small">@order.OrderTime.ToString("MMM dd, hh:mm tt")</div>
                            </td>

                            <!-- PICKUP TIME -->
                            <td class="py-3">
                                <div class="text-dark small fw-medium">
                                    <i class="bi bi-clock me-1 text-muted"></i>
                                    @(order.TimeSlot != null ? order.TimeSlot.SlotTime : order.OrderTime.AddMinutes(15).ToString("hh:mm tt"))
                                </div>
                            </td>

                            <!-- ITEMS COUNT WITH DETAIL TOOLTIP -->
                            <td class="py-3 text-center">
                                <span class="badge bg-light text-dark border px-3 py-2 rounded-pill fw-bold"
                                      data-bs-toggle="tooltip"
                                      data-bs-html="true"
                                      title="@string.Join("<br/>", order.OrderItems.Select(i => $"{i.MenuItem?.Name ?? "Item"} x{i.Quantity}"))">
                                    @totalItemsCount @(totalItemsCount == 1 ? "item" : "items")
                                </span>
                            </td>

                            <!-- TOTAL AMOUNT -->
                            <td class="py-3">
                                <span class="fw-bold text-primary fs-6">
                                    <i class="bi bi-coin text-warning me-1"></i>@order.TotalAmount.ToString("N0") Tokens
                                </span>
                            </td>

                            <!-- STATUS BADGE -->
                            <td class="py-3">
                                <span class="badge rounded-pill px-3 py-2 fw-bold text-uppercase @statusClass" style="font-size: 0.7rem;">
                                    @(statusStr == "Pending" ? "PREPARING" : statusStr)
                                </span>
                            </td>

                            <!-- ACTIONS MODAL TRIGGER -->
                            <td class="pe-4 py-3 text-end">
                                <button type="button" class="btn btn-sm btn-light border rounded-circle shadow-sm" data-bs-toggle="modal" data-bs-target="#updateModal-@order.Id">
                                    <i class="bi bi-three-dots-vertical"></i>
                                </button>

                                <!-- STATUS UPDATE MODAL -->
                                <div class="modal fade text-start" id="updateModal-@order.Id" tabindex="-1" aria-hidden="true">
                                    <div class="modal-dialog modal-dialog-centered">
                                        <div class="modal-content rounded-4 border-0 shadow">
                                            <div class="modal-header border-bottom-0 pb-0">
                                                <h5 class="modal-title fw-bold text-dark">Update Order #@order.Id.ToString("D3")</h5>
                                                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                                            </div>
                                            <form asp-action="UpdateOrderStatus" method="post">
                                                @Html.AntiForgeryToken()
                                                <input type="hidden" name="orderId" value="@order.Id" />

                                                <div class="modal-body py-3">
                                                    <div class="mb-3 bg-light p-3 rounded-3 border">
                                                        <div class="fw-bold text-dark mb-1">@order.StudentName</div>
                                                        <div class="small text-muted mb-2">Order Items:</div>
                                                        <ul class="list-unstyled mb-0 small">
                                                            @foreach (var item in order.OrderItems)
                                                            {
                                                                <li class="d-flex justify-content-between py-1 border-bottom border-light-subtle">
                                                                    <span>@item.MenuItem?.Name</span>
                                                                    <span class="fw-bold text-danger">x@item.Quantity</span>
                                                                </li>
                                                            }
                                                        </ul>
                                                    </div>

                                                    <div class="mb-3">
                                                        <label class="form-label small fw-bold text-dark">Order Status</label>
                                                        <select name="status" class="form-select rounded-3 fw-semibold">
                                                            <option value="Preparing" selected="@(statusStr == "Preparing" || statusStr == "Pending")">Preparing</option>
                                                            <option value="Ready" selected="@(statusStr == "Ready")">Ready for Pickup</option>
                                                            <option value="Completed" selected="@(statusStr == "Completed")">Completed</option>
                                                            <option value="Cancelled" selected="@(statusStr == "Cancelled")">Cancelled</option>
                                                        </select>
                                                    </div>

                                                    <div class="mb-3">
                                                        <label class="form-label small fw-bold text-dark">Notification Message to Student</label>
                                                        <input type="text" name="adminMessage" class="form-control rounded-3"
                                                               placeholder="e.g. Your food is hot and ready at Counter 1!"
                                                               value="@(string.IsNullOrEmpty(order.AdminMessage) ? "Your order is ready for pickup!" : order.AdminMessage)" />
                                                    </div>
                                                </div>
                                                <div class="modal-footer border-top-0 pt-0">
                                                    <button type="button" class="btn btn-light rounded-pill px-4 fw-semibold" data-bs-dismiss="modal">Cancel</button>
                                                    <button type="submit" class="btn btn-danger rounded-pill px-4 fw-bold">
                                                        Update & Notify
                                                    </button>
                                                </div>
                                            </form>
                                        </div>
                                    </div>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>

@section Scripts {
    <script>
        document.addEventListener("DOMContentLoaded", function() {
            var tooltipTriggerList = [].slice.call(document.querySelectorAll('[data-bs-toggle="tooltip"]'));
            tooltipTriggerList.map(function(tooltipTriggerEl) {
                return new bootstrap.Tooltip(tooltipTriggerEl);
            });
        });
    </script>
}