@model FeedMe.Models.MenuItem
@{
    ViewData["Title"] = "Edit Product";
    Layout = "_AdminLayout";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h3 class="fw-bold text-dark m-0">Edit Product</h3>
        <p class="text-muted small m-0">Update item details, category, pricing, or product image.</p>
    </div>
    <a asp-action="Inventory" class="btn btn-outline-secondary rounded-pill px-4 fw-semibold">
        <i class="bi bi-arrow-left me-1"></i> Back to Inventory
    </a>
</div>

<div class="row justify-content-center">
    <div class="col-md-8">
        <div class="card border-0 shadow-sm rounded-4 p-4 bg-white">
            <form asp-action="EditItem" method="post" enctype="multipart/form-data">
                @Html.AntiForgeryToken()
                <input type="hidden" asp-for="Id" />
                <input type="hidden" asp-for="ImageUrl" />

                <div asp-validation-summary="ModelOnly" class="text-danger small mb-3"></div>

                <!-- Product Name -->
                <div class="mb-3">
                    <label asp-for="Name" class="form-label fw-semibold text-dark">Product Name</label>
                    <input asp-for="Name" class="form-control rounded-3" placeholder="e.g. Chicken MoMo" required />
                    <span asp-validation-for="Name" class="text-danger small"></span>
                </div>

                <!-- Category & Price -->
                <div class="row mb-3">
                    <div class="col-md-6">
                        <label asp-for="CategoryId" class="form-label fw-semibold text-dark">Category</label>
                        <select asp-for="CategoryId" class="form-select rounded-3" asp-items="@(new SelectList(ViewBag.Categories, "Id", "Name"))" required>
                            <option value="">-- Select Category --</option>
                        </select>
                        <span asp-validation-for="CategoryId" class="text-danger small"></span>
                    </div>

                    <div class="col-md-6">
                        <label asp-for="Price" class="form-label fw-semibold text-dark">Price</label>
                        <div class="input-group">
                            <span class="input-group-text bg-light text-muted fw-bold">Rs</span>
                            <input asp-for="Price" class="form-control rounded-3" type="number" step="0.01" required />
                        </div>
                        <span asp-validation-for="Price" class="text-danger small"></span>
                    </div>
                </div>

                <!-- Stock Quantity -->
                <div class="mb-3">
                    <label asp-for="StockQuantity" class="form-label fw-semibold text-dark">Stock Quantity</label>
                    <input asp-for="StockQuantity" class="form-control rounded-3" type="number" placeholder="e.g. 50" />
                    <span asp-validation-for="StockQuantity" class="text-danger small"></span>
                </div>

                <!-- Description -->
                <div class="mb-3">
                    <label asp-for="Description" class="form-label fw-semibold text-dark">Description</label>
                    <textarea asp-for="Description" class="form-control rounded-3" rows="3" placeholder="Brief product description..."></textarea>
                    <span asp-validation-for="Description" class="text-danger small"></span>
                </div>

                <!-- Image Upload & Preview -->
                <div class="mb-4">
                    <label class="form-label fw-semibold text-dark">Product Image</label>
                    @if (!string.IsNullOrEmpty(Model.ImageUrl))
                    {
                        <div class="mb-2">
                            <img src="@Model.ImageUrl" alt="@Model.Name" class="rounded-3 border shadow-sm" style="max-height: 120px; object-fit: cover;" />
                        </div>
                    }
                    <input type="file" name="ImageFile" class="form-control rounded-3" accept="image/*" />
                    <small class="text-muted d-block mt-1">Leave blank if you don't want to change the current image.</small>
                </div>

                <!-- Availability Switches -->
                <div class="card bg-light border-0 rounded-3 p-3 mb-4">
                    <div class="form-check form-switch mb-2">
                        <input asp-for="IsAvailable" class="form-check-input" type="checkbox" id="publishSwitch">
                        <label class="form-check-label fw-semibold text-dark" for="publishSwitch">
                            In Stock / Available
                        </label>
                    </div>

                    <div class="form-check form-switch">
                        <input asp-for="IsHotMeal" class="form-check-input" type="checkbox" id="hotMealSwitch">
                        <label class="form-check-label fw-semibold text-dark" for="hotMealSwitch">
                            Feature as Hot Meal (Landing page hero display)
                        </label>
                    </div>
                </div>

                <!-- Action Buttons -->
                <div class="d-flex justify-content-end gap-2">
                    <a asp-action="Inventory" class="btn btn-outline-secondary rounded-pill px-4 fw-semibold">Cancel</a>
                    <button type="submit" class="btn btn-danger rounded-pill px-4 fw-bold shadow-sm">
                        <i class="bi bi-check-lg me-1"></i> Update Product
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}