@model FeedMe.Models.TimeSlot
@{
    ViewData["Title"] = "Add Time Slot";
    Layout = "_AdminLayout";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h3 class="fw-bold text-dark m-0">Add New Time Slot</h3>
        <p class="text-muted small m-0">Configure food pickup time intervals for student orders.</p>
    </div>
    <a asp-action="Slots" class="btn btn-light border rounded-pill px-4 fw-semibold">
        <i class="bi bi-arrow-left me-1"></i> Back to Slots
    </a>
</div>

<div class="row justify-content-center">
    <div class="col-md-8 col-lg-6">
        <div class="card border-0 shadow-sm rounded-4 bg-white p-4">
            <form asp-action="CreateSlot" method="post">
                @Html.AntiForgeryToken()
                <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                <!-- Start Time -->
                <div class="mb-3">
                    <label asp-for="StartTime" class="form-label fw-bold text-dark">Start Time</label>
                    <input asp-for="StartTime" type="datetime-local" class="form-control rounded-3" required />
                    <span asp-validation-for="StartTime" class="text-danger small"></span>
                </div>

                <!-- End Time -->
                <div class="mb-4">
                    <label asp-for="EndTime" class="form-label fw-bold text-dark">End Time</label>
                    <input asp-for="EndTime" type="datetime-local" class="form-control rounded-3" required />
                    <span asp-validation-for="EndTime" class="text-danger small"></span>
                </div>

                <div class="d-flex justify-content-end gap-2">
                    <a asp-action="Slots" class="btn btn-light rounded-pill px-4 fw-semibold">Cancel</a>
                    <button type="submit" class="btn btn-danger rounded-pill px-4 fw-bold shadow-sm">
                        <i class="bi bi-plus-lg me-1"></i> Save Time Slot
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}