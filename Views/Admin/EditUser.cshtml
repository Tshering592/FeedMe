@model FeedMe.ViewModels.EditUserViewModel
@{
    ViewData["Title"] = "Edit User - Admin";
}

<style>
    header, footer, nav.navbar, .navbar {
        display: none !important;
    }

    html, body {
        background-color: #f8fafc !important;
        margin: 0 !important;
        padding: 0 !important;
        height: 100%;
    }

    .admin-edit-wrap {
        min-height: 100vh;
        display: flex;
        align-items: center;
        justify-content: center;
        padding: 2.5rem 1rem;
    }

    .admin-edit-card {
        background: #fff;
        border-radius: 20px;
        box-shadow: 0 6px 20px rgba(15, 23, 42, 0.08);
        padding: 2.25rem;
        width: 100%;
        max-width: 520px;
    }
</style>

<div class="admin-edit-wrap">
    <div class="admin-edit-card">
        <div class="mb-4">
            <h4 class="fw-bold text-dark m-0">Edit User</h4>
            <p class="text-muted small mt-1 mb-0">Update account details for @Model.Role — @Model.Email</p>
        </div>

        <div asp-validation-summary="ModelOnly" class="text-danger small mb-3"></div>

        <form asp-action="EditUser" method="post">
            @Html.AntiForgeryToken()
            <input type="hidden" asp-for="Id" />
            <input type="hidden" asp-for="Role" />

            <div class="mb-3">
                <label asp-for="FullName" class="form-label fw-semibold small">Full Name</label>
                <input asp-for="FullName" class="form-control" />
                <span asp-validation-for="FullName" class="text-danger small"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Email" class="form-label fw-semibold small">Email Address</label>
                <input asp-for="Email" class="form-control" />
                <span asp-validation-for="Email" class="text-danger small"></span>
            </div>

            <div class="mb-3">
                <label asp-for="ContactNumber" class="form-label fw-semibold small">Contact No</label>
                <input asp-for="ContactNumber" class="form-control" />
                <span asp-validation-for="ContactNumber" class="text-danger small"></span>
            </div>

            <div class="mb-4">
                <label asp-for="DietaryPreference" class="form-label fw-semibold small">Dietary Preference</label>
                <input asp-for="DietaryPreference" class="form-control" />
            </div>

            <div class="d-flex gap-2 justify-content-end">
                <a asp-action="Users" class="btn btn-outline-secondary rounded-pill px-4">Cancel</a>
                <button type="submit" class="btn btn-danger rounded-pill px-4 fw-bold">Save Changes</button>
            </div>
        </form>
    </div>
</div>