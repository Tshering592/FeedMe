@using FeedMe.Models
@model List<FeedMe.ViewModels.UserWithRoleViewModel>
@{
    ViewData["Title"] = "User Directory - Admin";
    string currentFilter = ViewBag.CurrentFilter as string ?? "";
}

<!-- BREAK OUT OF DEFAULT TEMPLATE CONTAINER & ANCHOR EDGE-TO-EDGE -->
<style>
    /* Hide site navbar and footer if present */
    header, footer, nav.navbar, .navbar {
        display: none !important;
    }

    html, body {
        background-color: #f8fafc !important;
        margin: 0 !important;
        padding: 0 !important;
        height: 100%;
        overflow: hidden;
    }

    /* Fixed Left Sidebar */
    .admin-sidebar {
        width: 250px;
        height: 100vh;
        position: fixed;
        top: 0;
        left: 0;
        background-color: #0f172a;
        z-index: 1000;
        overflow-y: auto;
    }

    /* Absolute Viewport Anchoring: Fills screen from 250px (sidebar width) to right edge */
    .admin-main-content {
        position: fixed;
        top: 0;
        left: 0;
        right: 0;
        bottom: 0;
        overflow-y: auto;
        padding: 32px 40px;
        box-sizing: border-box;
        background-color: #f8fafc;
    }

        /* Force width on directory cards and tables */
        .admin-main-content .card,
        .admin-main-content .table-responsive,
        .admin-main-content table {
            width: 100%;
            max-width: 100%;
        }

        /* Table Column Layout */
        .admin-main-content table {
            table-layout: auto;
        }

        .admin-main-content th,
        .admin-main-content td {
            white-space: nowrap;
        }

    /* Responsive: collapse sidebar to a top bar on small viewports */
    @@media (max-width: 900px) {
        .admin-sidebar {
            width: 100%;
            height: auto;
            position: fixed;
            top: 0;
            left: 0;
            right: 0;
            flex-direction: row !important;
            align-items: center;
            padding: 10px 16px !important;
            overflow-x: auto;
        }

            .admin-sidebar .nav {
                flex-direction: row !important;
                gap: 6px !important;
            }

            .admin-sidebar .border-top,
            .admin-sidebar .border-bottom {
                border: none !important;
            }

        .admin-main-content {
            left: 0;
            right: 0;
            top: 64px;
            padding: 16px 20px;
        }
    }
</style>

<div class="d-flex">
    <!-- ADMIN SIDEBAR -->
    <div class="admin-sidebar text-white p-3 d-flex flex-column justify-content-between">
        <div>
            <!-- Top Branding -->
            <div class="d-flex align-items-center gap-3 mb-4 pb-3 border-bottom border-secondary border-opacity-25">
                <div class="bg-danger rounded-circle p-2 d-flex align-items-center justify-content-center shadow-sm" style="width: 42px; height: 42px; min-width: 42px;">
                    <i class="bi bi-cup-hot-fill text-white fs-5"></i>
                </div>
                <div class="text-truncate">
                    <h6 class="fw-bold m-0 text-white text-truncate" style="font-size: 0.95rem;">TCMIT CANTEEN</h6>
                    <span class="text-danger small fw-semibold" style="font-size: 0.75rem;">Admin Portal</span>
                </div>
            </div>

            <!-- Navigation Links -->
            <ul class="nav nav-pills flex-column gap-2">
                <li class="nav-item">
                    <a asp-action="Dashboard" class="nav-link text-secondary fw-semibold rounded-3 py-2 px-3 text-white-50">
                        <i class="bi bi-grid-fill me-2 fs-5 align-middle"></i> Dashboard
                    </a>
                </li>
                <li class="nav-item">
                    <a asp-action="Inventory" class="nav-link text-secondary fw-semibold rounded-3 py-2 px-3 text-white-50">
                        <i class="bi bi-box-seam me-2 fs-5 align-middle"></i> Inventory
                    </a>
                </li>
                <li class="nav-item">
                    <a asp-action="MenuManagement" class="nav-link text-secondary fw-semibold rounded-3 py-2 px-3 text-white-50">
                        <i class="bi bi-list-task me-2 fs-5 align-middle"></i> Menu Management
                    </a>
                </li>
                <li class="nav-item">
                    <a asp-action="Orders" class="nav-link text-secondary fw-semibold rounded-3 py-2 px-3 text-white-50">
                        <i class="bi bi-card-checklist me-2 fs-5 align-middle"></i> Orders
                    </a>
                </li>
                <li class="nav-item">
                    <a asp-action="TimeSlots" class="nav-link text-secondary fw-semibold rounded-3 py-2 px-3 text-white-50">
                        <i class="bi bi-clock me-2 fs-5 align-middle"></i> Time Slots
                    </a>
                </li>
                <li class="nav-item">
                    <a asp-action="Users" class="nav-link active bg-danger fw-bold rounded-3 py-2 px-3">
                        <i class="bi bi-people-fill me-2 fs-5 align-middle"></i> Users
                    </a>
                </li>
                <li class="nav-item">
                    <a asp-action="Vault" class="nav-link text-secondary fw-semibold rounded-3 py-2 px-3 text-white-50">
                        <i class="bi bi-safe-fill me-2 fs-5 align-middle"></i> Token Vault
                    </a>
                </li>
                <li class="nav-item">
                    <a asp-action="Transactions" class="nav-link text-secondary fw-semibold rounded-3 py-2 px-3 text-white-50">
                        <i class="bi bi-receipt me-2 fs-5 align-middle"></i> Transactions
                    </a>
                </li>
            </ul>
        </div>

        <!-- Logout Button -->
        <div class="pt-3 border-top border-secondary border-opacity-25">
            <form asp-controller="Account" asp-action="Logout" method="post">
                @Html.AntiForgeryToken()
                <button type="submit" class="btn text-danger w-100 text-start fw-bold p-0 border-0 bg-transparent">
                    <i class="bi bi-box-arrow-left me-2 fs-5 align-middle"></i> Logout
                </button>
            </form>
        </div>
    </div>

    <!-- MAIN SCROLLABLE CONTENT -->
    <div class="admin-main-content">
        <!-- Page Header -->
        <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center mb-4 gap-3">
            <div>
                <h2 class="fw-bold text-dark m-0">User Directory</h2>
                <p class="text-muted small mt-1 mb-0">Manage registered student and staff accounts across TCMIT Canteen.</p>
            </div>
            <div>
                <a asp-action="Vault" class="btn btn-warning fw-bold rounded-pill px-4 py-2 shadow-sm">
                    <i class="bi bi-safe-fill me-2"></i> Open Token Vault & Transfers
                </a>
            </div>
        </div>

        <!-- Alert Banners -->
        @if (TempData["Success"] != null)
        {
            <div class="alert alert-success alert-dismissible fade show rounded-4 border-0 shadow-sm mb-4">
                <i class="bi bi-check-circle-fill me-2"></i> @TempData["Success"]
                <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
            </div>
        }
        @if (TempData["Error"] != null)
        {
            <div class="alert alert-danger alert-dismissible fade show rounded-4 border-0 shadow-sm mb-4">
                <i class="bi bi-exclamation-triangle-fill me-2"></i> @TempData["Error"]
                <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
            </div>
        }

        <!-- Role Category Filter Buttons -->
        <div class="d-flex flex-wrap gap-2 mb-4">
            <a asp-action="Users" class="btn btn-sm rounded-pill px-4 py-2 fw-bold @(string.IsNullOrEmpty(currentFilter) ? "btn-danger shadow-sm" : "btn-outline-secondary bg-white")">
                <i class="bi bi-people me-1"></i> All Users
            </a>
            <a asp-action="Users" asp-route-roleFilter="Student" class="btn btn-sm rounded-pill px-4 py-2 fw-bold @(currentFilter == "Student" ? "btn-danger shadow-sm" : "btn-outline-secondary bg-white")">
                <i class="bi bi-mortarboard me-1"></i> Students Only
            </a>
            <a asp-action="Users" asp-route-roleFilter="Staff" class="btn btn-sm rounded-pill px-4 py-2 fw-bold @(currentFilter == "Staff" ? "btn-danger shadow-sm" : "btn-outline-secondary bg-white")">
                <i class="bi bi-person-badge me-1"></i> Staff Only
            </a>
        </div>

        <!-- Full-Width Directory Table Card -->
        <div class="card border-0 shadow-sm rounded-4 bg-white overflow-hidden w-100 mb-4">
            @if (Model == null || !Model.Any())
            {
                <div class="p-5 text-center">
                    <i class="bi bi-person-x fs-1 text-muted d-block mb-2"></i>
                    <h6 class="fw-bold text-dark m-0">No accounts found</h6>
                    <p class="text-muted small mt-1 mb-0">There are no user accounts registered under the "@(string.IsNullOrEmpty(currentFilter) ? "All Users" : currentFilter)" filter.</p>
                </div>
            }
            else
            {
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0 w-100">
                        <thead class="bg-light border-bottom text-uppercase text-muted" style="font-size: 0.75rem;">
                            <tr>
                                <th class="ps-4 py-3">Full Name</th>
                                <th class="py-3">Email Address</th>
                                <th class="py-3">Role</th>
                                <th class="py-3">Identifier (ID / LCID)</th>
                                <th class="py-3">Token Balance</th>
                                <th class="py-3">Contact No</th>
                                <th class="py-3">Dietary Pref</th>
                                <th class="py-3 text-end">Registered On</th>
                                <th class="pe-4 py-3 text-end">Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var item in Model)
                            {
                                <tr>
                                    <td class="ps-4 py-3 fw-bold text-dark">
                                        @(string.IsNullOrEmpty(item.User.FullName) ? "N/A" : item.User.FullName)
                                    </td>
                                    <td class="py-3 small text-muted">@item.User.Email</td>
                                    <td class="py-3">
                                        <span class="badge rounded-pill px-3 py-2 fw-bold @(item.Role == "Staff" ? "bg-primary-subtle text-primary border border-primary-subtle" : item.Role == "Admin" ? "bg-dark text-white" : "bg-danger-subtle text-danger border border-danger-subtle")">
                                            @item.Role
                                        </span>
                                    </td>
                                    <td class="py-3 small text-dark fw-semibold">
                                        @if (item.Role == "Staff")
                                        {
                                            <span>Staff ID: @(item.User.StaffId ?? "N/A")</span>
                                        }
                                        else
                                        {
                                            <span>LCID: @(item.User.StudentLcid ?? item.User.StudentId ?? "N/A")</span>
                                        }
                                    </td>
                                    <td class="py-3 fw-bold text-success">
                                        <i class="bi bi-coin me-1"></i> @item.User.TokenBalance Tokens
                                    </td>
                                    <td class="py-3 small text-muted">
                                        @(item.User.ContactNumber ?? item.User.PhoneNumber ?? "-")
                                    </td>
                                    <td class="py-3 small">
                                        <span class="badge bg-light text-dark border rounded-pill px-2 py-1">
                                            @(item.User.DietaryPreference ?? "ALL")
                                        </span>
                                    </td>
                                    <td class="py-3 small text-muted text-end">
                                        @item.User.CreatedAt.ToString("yyyy-MM-dd")
                                    </td>
                                    <td class="pe-4 py-3 text-end">
                                        <div class="d-flex gap-2 justify-content-end">
                                            <a asp-action="EditUser" asp-route-id="@item.User.Id" class="btn btn-sm btn-outline-primary rounded-pill px-3">
                                                <i class="bi bi-pencil-square"></i> Edit
                                            </a>
                                            @if (item.Role != "Admin")
                                            {
                                                <form asp-action="DeleteUser" asp-route-id="@item.User.Id" method="post"
                                                      onsubmit="return confirm('Delete this user? This action cannot be undone.');">
                                                    @Html.AntiForgeryToken()
                                                    <button type="submit" class="btn btn-sm btn-outline-danger rounded-pill px-3">
                                                        <i class="bi bi-trash3"></i> Delete
                                                    </button>
                                                </form>
                                            }
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>
    </div>
</div>