@model IEnumerable<FeedMe.Models.MenuItem>
@{
    ViewData["Title"] = "Full Canteen Menu - Staff";
    var userBalance = ViewBag.UserBalance as decimal? ?? 0m;
    var timeSlots = (ViewBag.TimeSlots as List<FeedMe.Models.TimeSlot>) ?? new List<FeedMe.Models.TimeSlot>();
    var categories = (ViewBag.Categories as IEnumerable<FeedMe.Models.Category>) ?? new List<FeedMe.Models.Category>();
}

<style>
    /* Hide default site navbar and footer */
    header, footer, nav.navbar, .navbar {
        display: none !important;
    }

    html, body {
        background-color: #f8fafc !important;
        margin: 0 !important;
        padding: 0 !important;
        height: 100vh !important;
        overflow: hidden !important;
    }

    /* Fixed Dark Sidebar */
    .staff-sidebar {
        width: 250px;
        height: 100vh;
        position: fixed;
        top: 0;
        left: 0;
        background-color: #0f172a;
        z-index: 1000;
    }

    /* Main Content Container */
    .staff-main-content {
        position: fixed !important;
        top: 0 !important;
        left: 250px !important;
        right: 0 !important;
        bottom: 0 !important;
        height: 100vh !important;
        overflow-y: auto !important;
        padding: 32px 40px !important;
        box-sizing: border-box;
    }

    .nav-link.active-staff {
        background-color: #0d6efd !important;
        color: #ffffff !important;
        font-weight: 700 !important;
    }
</style>

<div class="d-flex">
    <!-- SIDEBAR -->
    <div class="staff-sidebar text-white p-3 d-flex flex-column justify-content-between">
        <div>
            <!-- Header Brand -->
            <div class="d-flex align-items-center gap-3 mb-4 pb-3 border-bottom border-secondary border-opacity-25">
                <div class="bg-primary rounded-circle p-2 d-flex align-items-center justify-content-center shadow-sm" style="width: 42px; height: 42px; min-width: 42px;">
                    <i class="bi bi-cup-hot-fill text-white fs-5"></i>
                </div>
                <div class="text-truncate">
                    <h6 class="fw-bold m-0 text-white text-truncate" style="font-size: 0.95rem;">TCMIT CANTEEN</h6>
                    <span class="text-primary small fw-semibold" style="font-size: 0.75rem;">Staff Portal</span>
                </div>
            </div>

            <!-- Navigation Links -->
            <ul class="nav nav-pills flex-column gap-2">
                <li class="nav-item">
                    <a asp-action="Dashboard" class="nav-link text-secondary fw-semibold rounded-3 py-2 px-3 text-white-50"><i class="bi bi-grid-fill me-2 fs-5 align-middle"></i> Dashboard</a>
                </li>
                <li class="nav-item">
                    <a asp-action="FullMenu" class="nav-link active bg-primary fw-bold rounded-3 py-2 px-3"><i class="bi bi-journal-text me-2 fs-5 align-middle"></i> Canteen Menu</a>
                </li>
                <li class="nav-item">
                    <a asp-action="Orders" class="nav-link text-secondary fw-semibold rounded-3 py-2 px-3 text-white-50"><i class="bi bi-clock-history me-2 fs-5 align-middle"></i> My Orders</a>
                </li>
                <li class="nav-item">
                    <a asp-action="Vault" class="nav-link text-secondary fw-semibold rounded-3 py-2 px-3 text-white-50"><i class="bi bi-safe-fill me-2 fs-5 align-middle"></i> Token Vault</a>
                </li>
                <li class="nav-item">
                    <a asp-action="Statements" class="nav-link text-secondary fw-semibold rounded-3 py-2 px-3 text-white-50"><i class="bi bi-file-earmark-text-fill me-2 fs-5 align-middle"></i> Statement</a>
                </li>
                <li class="nav-item">
                    <a asp-action="Notifications" class="nav-link text-secondary fw-semibold rounded-3 py-2 px-3 text-white-50"><i class="bi bi-bell-fill me-2 fs-5 align-middle"></i> Notifications</a>
                </li>
                <li class="nav-item">
                    <a asp-action="Profile" class="nav-link text-secondary fw-semibold rounded-3 py-2 px-3 text-white-50"><i class="bi bi-person-circle me-2 fs-5 align-middle"></i> Profile</a>
                </li>
            </ul>
        </div>

        <!-- Logout Form -->
        <div class="pt-3 border-top border-secondary border-opacity-25">
            <form asp-controller="Account" asp-action="Logout" method="post">
                @Html.AntiForgeryToken()
                <button type="submit" class="btn text-danger w-100 text-start fw-bold p-0 border-0 bg-transparent">
                    <i class="bi bi-box-arrow-left me-2 fs-5 align-middle"></i> Logout
                </button>
            </form>
        </div>
    </div>

    <!-- MAIN CONTENT -->
    <div class="staff-main-content">
        @if (TempData["Success"] != null)
        {
            <div class="alert alert-success alert-dismissible fade show rounded-4 border-0 shadow-sm mb-4" role="alert">
                <i class="bi bi-check-circle-fill me-2"></i> @TempData["Success"]
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
            </div>
        }
        @if (TempData["Error"] != null)
        {
            <div class="alert alert-danger alert-dismissible fade show rounded-4 border-0 shadow-sm mb-4" role="alert">
                <i class="bi bi-exclamation-triangle-fill me-2"></i> @TempData["Error"]
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
            </div>
        }

        <form asp-action="PlaceMultiOrder" method="post">
            @Html.AntiForgeryToken()

            <!-- TOP HEADER BAR -->
            <div class="d-flex flex-wrap justify-content-between align-items-center gap-3 mb-4">
                <div>
                    <h2 class="fw-bold text-dark m-0">Full Canteen Menu</h2>
                    <p class="text-muted small m-0">Select item quantities, pick a pickup time slot, and submit your order.</p>
                </div>

                <div class="d-flex align-items-center gap-3">
                    <!-- WALLET CARD -->
                    <div class="bg-white rounded-pill px-4 py-2 border shadow-sm d-flex align-items-center gap-3">
                        <div class="bg-warning bg-opacity-25 text-warning rounded-circle p-2 d-flex align-items-center justify-content-center" style="width: 36px; height: 36px;">
                            <i class="bi bi-coin fs-5"></i>
                        </div>
                        <div>
                            <span class="text-muted extra-small d-block text-uppercase fw-bold" style="font-size: 0.7rem;">Wallet Balance</span>
                            <span class="fw-bold text-primary fs-6">@userBalance.ToString("F2") Tokens</span>
                        </div>
                    </div>

                    <!-- SUBMIT BUTTON -->
                    <button type="submit" class="btn btn-primary rounded-pill px-4 py-2.5 fw-bold shadow-sm">
                        <i class="bi bi-cart-plus-fill me-1"></i> Submit Multi-Item Order
                    </button>
                </div>
            </div>

            <!-- CATEGORIES & TIME SLOT BAR -->
            <div class="d-flex flex-wrap justify-content-between align-items-center gap-3 mb-4">
                <!-- CATEGORY FILTER BUTTONS (DYNAMIC) -->
                <div class="btn-group rounded-pill bg-white p-1 border shadow-sm" role="group" id="categoryFilterGroup">
                    <button type="button" class="btn btn-sm btn-primary rounded-pill fw-bold category-btn px-3 active" data-category="All">All Categories</button>
                    @if (categories.Any())
                    {
                        foreach (var cat in categories)
                        {
                            <button type="button" class="btn btn-sm btn-light rounded-pill fw-bold category-btn px-3 text-muted" data-category="@cat.Name">
                                @cat.Name
                            </button>
                        }
                    }
                </div>

                <!-- TIME SLOT DROPDOWN -->
                <div style="min-width: 280px;">
                    <div class="input-group shadow-sm rounded-pill overflow-hidden border">
                        <span class="input-group-text bg-white border-0 text-primary ps-3"><i class="bi bi-clock-history"></i></span>
                        <select name="TimeSlotId" class="form-select border-0 bg-white fw-semibold text-dark py-2" required>
                            <option value="" disabled selected>-- Choose Pickup Time Slot --</option>
                            @if (timeSlots.Any())
                            {
                                @foreach (var slot in timeSlots)
                                {
                                    <option value="@slot.Id">
                                        @slot.StartTime - @slot.EndTime
                                    </option>
                                }
                            }
                        </select>
                    </div>
                </div>
            </div>

            <!-- MENU ITEMS TABLE -->
            <div class="card border-0 shadow-sm rounded-4 bg-white overflow-hidden">
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0">
                        <thead class="table-light">
                            <tr>
                                <th class="border-0 text-secondary small fw-bold text-uppercase ps-4">Image</th>
                                <th class="border-0 text-secondary small fw-bold text-uppercase">Item Details</th>
                                <th class="border-0 text-secondary small fw-bold text-uppercase text-center">Category</th>
                                <th class="border-0 text-secondary small fw-bold text-uppercase text-center">Price</th>
                                <th class="border-0 text-secondary small fw-bold text-uppercase text-center pe-4">Select Quantity</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (Model == null || !Model.Any())
                            {
                                <tr>
                                    <td colspan="5" class="text-center text-muted py-5">No canteen menu items available at the moment.</td>
                                </tr>
                            }
                            else
                            {
                                int index = 0;
                                @foreach (var item in Model)
                                {
                                    <tr class="menu-item-row" data-category="@item.Category?.Name">
                                        <td class="ps-4" style="width: 90px;">
                                            @if (!string.IsNullOrEmpty(item.ImageUrl))
                                            {
                                                <img src="@item.ImageUrl" alt="@item.Name" class="rounded-3 object-fit-cover shadow-sm" style="width: 54px; height: 54px;" />
                                            }
                                            else
                                            {
                                                <div class="bg-light rounded-3 d-flex align-items-center justify-content-center text-muted shadow-sm" style="width: 54px; height: 54px;">
                                                    <i class="bi bi-image fs-4"></i>
                                                </div>
                                            }
                                        </td>
                                        <td>
                                            <h6 class="fw-bold text-dark m-0">@item.Name</h6>
                                            <p class="text-muted small m-0 text-truncate" style="max-width: 320px;">@item.Description</p>
                                        </td>
                                        <td class="text-center">
                                            <span class="badge bg-light text-dark border rounded-pill px-3 py-1 fw-bold">@item.Category?.Name</span>
                                        </td>
                                        <td class="text-center">
                                            <span class="badge bg-primary bg-opacity-10 text-primary rounded-pill px-3 py-1 fw-bold fs-6">
                                                <i class="bi bi-coin text-warning me-1"></i>@item.Price.ToString("F0")
                                            </span>
                                        </td>
                                        <td class="text-center pe-4" style="width: 160px;">
                                            <input type="hidden" name="SelectedItems[@index].MenuItemId" value="@item.Id" />
                                            <input type="number" min="0" max="20" name="SelectedItems[@index].Quantity" value="0" class="form-control text-center rounded-3 fw-bold border" />
                                        </td>
                                    </tr>
                                    index++;
                                }
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </form>
    </div>
</div>

<!-- CATEGORY FILTER SCRIPT -->
<script>
    document.addEventListener("DOMContentLoaded", function() {
        const categoryBtns = document.querySelectorAll(".category-btn");
        const menuRows = document.querySelectorAll(".menu-item-row");

        categoryBtns.forEach(btn => {
            btn.addEventListener("click", function() {
                categoryBtns.forEach(b => {
                    b.classList.remove("btn-primary", "active", "text-white");
                    b.classList.add("btn-light", "text-muted");
                });

                this.classList.remove("btn-light", "text-muted");
                this.classList.add("btn-primary", "active", "text-white");

                const selectedCategory = (this.getAttribute("data-category") || "").trim().toLowerCase();

                menuRows.forEach(row => {
                    const rowCategory = (row.getAttribute("data-category") || "").trim().toLowerCase();
                    if (selectedCategory === "all" || rowCategory === selectedCategory) {
                        row.style.display = "";
                    } else {
                        row.style.display = "none";
                    }
                });
            });
        });
    });
</script>