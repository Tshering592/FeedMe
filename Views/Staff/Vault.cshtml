@using FeedMe.Models
@{
    ViewData["Title"] = "My Token Vault - Staff Portal";
    var user = ViewBag.User as AppUser;
    var recentActivity = ViewBag.RecentActivity as List<TokenTransaction> ?? new List<TokenTransaction>();
}

<style>
    header, footer, nav.navbar, .navbar {
        display: none !important;
    }

    html, body {
        background-color: #f8fafc !important;
        margin: 0 !important;
        padding: 0 !important;
        height: 100vh !important;
        overflow: hidden !important;
    }

    .admin-sidebar {
        width: 250px;
        height: 100vh;
        height: 100dvh;
        position: fixed;
        top: 0;
        left: 0;
        background-color: #0f172a;
        z-index: 1000;
        overflow-y: auto;
    }

    .admin-main-content {
        position: fixed !important;
        top: 0 !important;
        left: 250px !important;
        right: 0 !important;
        bottom: 0 !important;
        height: 100vh !important;
        overflow-y: auto !important;
        padding: 32px 40px !important;
        box-sizing: border-box !important;
        background-color: #f8fafc !important;
    }

    @@media (max-width: 900px) {
        .mobile-topbar {
            display: flex !important;
        }

        .admin-sidebar {
            width: 260px !important;
            height: 100vh !important;
            height: 100dvh;
            position: fixed !important;
            top: 0 !important;
            left: 0 !important;
            transform: translateX(-100%);
            transition: transform 0.25s ease;
            z-index: 1050;
            flex-direction: column !important;
            padding: 16px !important;
            overflow-y: auto !important;
        }

            .admin-sidebar.mobile-open {
                transform: translateX(0);
            }

            .admin-sidebar .nav {
                flex-direction: column !important;
                gap: 8px !important;
            }

        .admin-main-content {
            left: 0 !important;
            top: 56px !important;
            padding: 16px 20px !important;
        }
    }

    /* Slim top bar shown only on mobile, with a hamburger button to open the drawer */
    .mobile-topbar {
        display: none;
        position: fixed;
        top: 0;
        left: 0;
        right: 0;
        height: 56px;
        background-color: #0f172a;
        z-index: 1030;
        align-items: center;
        gap: 12px;
        padding: 0 16px;
    }

    .mobile-nav-toggle {
        background: transparent;
        border: none;
        color: #ffffff;
        font-size: 1.5rem;
        line-height: 1;
        padding: 4px;
    }

    .sidebar-backdrop {
        display: none;
        position: fixed;
        inset: 0;
        background: rgba(0, 0, 0, 0.5);
        z-index: 1040;
    }

        .sidebar-backdrop.show {
            display: block;
        }
</style>

<!-- MOBILE TOP BAR (hamburger + brand) -->
<div class="mobile-topbar">
    <button type="button" class="mobile-nav-toggle" aria-label="Toggle menu">
        <i class="bi bi-list"></i>
    </button>
    <span class="fw-bold text-white">TCMIT CANTEEN</span>
</div>
<div class="sidebar-backdrop"></div>

<div class="d-flex">
    <!-- STAFF SIDEBAR -->
    <div class="admin-sidebar text-white p-3 d-flex flex-column justify-content-between">
        <div>
            <div class="d-flex align-items-center gap-3 mb-4 pb-3 border-bottom border-secondary border-opacity-25">
                <div class="bg-primary rounded-circle p-2 d-flex align-items-center justify-content-center shadow-sm" style="width: 42px; height: 42px; min-width: 42px;">
                    <i class="bi bi-cup-hot-fill text-white fs-5"></i>
                </div>
                <div class="text-truncate">
                    <h6 class="fw-bold m-0 text-white text-truncate" style="font-size: 0.95rem;">TCMIT CANTEEN</h6>
                    <span class="text-primary small fw-semibold" style="font-size: 0.75rem;">Staff Portal</span>
                </div>
            </div>

            <ul class="nav nav-pills flex-column gap-2">
                <li class="nav-item">
                    <a asp-action="Dashboard" class="nav-link text-secondary fw-semibold rounded-3 py-2 px-3 text-white-50"><i class="bi bi-grid-fill me-2 fs-5 align-middle"></i> Dashboard</a>
                </li>
                <li class="nav-item">
                    <a asp-action="FullMenu" class="nav-link text-secondary fw-semibold rounded-3 py-2 px-3 text-white-50"><i class="bi bi-journal-text me-2 fs-5 align-middle"></i> Canteen Menu</a>
                </li>
                <li class="nav-item">
                    <a asp-action="Orders" class="nav-link text-secondary fw-semibold rounded-3 py-2 px-3 text-white-50"><i class="bi bi-clock-history me-2 fs-5 align-middle"></i> My Orders</a>
                </li>
                <li class="nav-item">
                    <a asp-action="Vault" class="nav-link active bg-primary fw-bold rounded-3 py-2 px-3"><i class="bi bi-safe-fill me-2 fs-5 align-middle"></i> Token Vault</a>
                </li>
                <li class="nav-item">
                    <a asp-action="Statements" class="nav-link text-secondary fw-semibold rounded-3 py-2 px-3 text-white-50"><i class="bi bi-file-earmark-text-fill me-2 fs-5 align-middle"></i> Statement</a>
                </li>
                <li class="nav-item">
                    <a asp-action="Notifications" class="nav-link text-secondary fw-semibold rounded-3 py-2 px-3 text-white-50"><i class="bi bi-bell-fill me-2 fs-5 align-middle"></i> Notifications</a>
                </li>
                <li class="nav-item">
                    <a asp-action="Profile" class="nav-link text-secondary fw-semibold rounded-3 py-2 px-3 text-white-50"><i class="bi bi-person-circle me-2 fs-5 align-middle"></i> Profile</a>
                </li>
            </ul>
        </div>

        <div class="pt-3 border-top border-secondary border-opacity-25">
            <form asp-controller="Account" asp-action="Logout" method="post">
                @Html.AntiForgeryToken()
                <button type="submit" class="btn text-danger w-100 text-start fw-bold p-0 border-0 bg-transparent">
                    <i class="bi bi-box-arrow-left me-2 fs-5 align-middle"></i> Logout
                </button>
            </form>
        </div>
    </div>

    <!-- MAIN SCROLLABLE CONTENT -->
    <div class="admin-main-content">
        <div class="mb-4">
            <h2 class="fw-bold text-dark m-0">Staff Token Vault</h2>
            <p class="text-muted small mt-1 mb-0">Overview of your staff canteen token balance and overall wallet summary.</p>
        </div>

        <!-- BALANCE BANNER -->
        <div class="card border-0 shadow-sm rounded-4 bg-primary text-white p-4 mb-4">
            <div class="d-flex justify-content-between align-items-center">
                <div>
                    <span class="text-white-50 small fw-bold text-uppercase">Texas Currency Reserve</span>
                    <h1 class="fw-bold text-white m-0 mt-1 display-5"><i class="bi bi-coin me-2"></i>@user?.TokenBalance Tokens</h1>
                </div>
                <span class="badge bg-white text-primary fw-bold rounded-pill px-4 py-2 fs-6 shadow-sm">
                    <i class="bi bi-person-badge-fill me-1"></i> Staff Wallet
                </span>
            </div>
        </div>

        <!-- STATS CARDS -->
        <div class="row g-3 mb-4">
            <div class="col-md-6">
                <div class="card border-0 shadow-sm rounded-4 p-4 bg-white">
                    <span class="text-muted small fw-bold text-uppercase">Total Credits Received</span>
                    <h3 class="fw-bold text-success m-0 mt-1">+@ViewBag.TotalReceived Tokens</h3>
                </div>
            </div>
            <div class="col-md-6">
                <div class="card border-0 shadow-sm rounded-4 p-4 bg-white">
                    <span class="text-muted small fw-bold text-uppercase">Total Food Payments</span>
                    <h3 class="fw-bold text-primary m-0 mt-1">-@ViewBag.TotalSpent Tokens</h3>
                </div>
            </div>
        </div>
    </div>
</div>