@using FeedMe.Models
@{
    ViewData["Title"] = "Staff Canteen Portal";
    var user = ViewBag.User as AppUser;
    var featuredItems = ViewBag.FeaturedItems as List<MenuItem> ?? new List<MenuItem>();
    var timeSlots = ViewBag.TimeSlots as List<TimeSlot> ?? new List<TimeSlot>();
    var recentOrders = ViewBag.RecentOrders as List<Order> ?? new List<Order>();
    var notifications = ViewBag.Notifications as List<Notification> ?? new List<Notification>();
}

<!-- HIDE DEFAULT WEBSITE NAVBAR/FOOTER & OVERRIDE LAYOUT -->
<style>
    header, footer, nav.navbar, .navbar {
        display: none !important;
    }

    html, body {
        background-color: #f8fafc !important;
        margin: 0 !important;
        padding: 0 !important;
        height: 100%;
        overflow: hidden;
    }

    .admin-sidebar {
        width: 260px;
        height: 100vh;
        height: 100dvh;
        position: fixed;
        top: 0;
        left: 0;
        background-color: #0f172a;
        z-index: 1000;
        overflow-y: auto;
    }

    .admin-main-content {
        position: fixed;
        top: 0;
        left: 260px;
        right: 0;
        bottom: 0;
        overflow-y: auto;
        padding: 24px 32px;
        box-sizing: border-box;
    }

        .admin-main-content .card,
        .admin-main-content .table-responsive,
        .admin-main-content table {
            width: 100%;
            max-width: 100%;
        }

    .notif-bell-btn {
        width: 48px;
        height: 48px;
        min-width: 48px;
        background: rgba(255, 255, 255, 0.18);
        backdrop-filter: blur(8px);
        border: 1px solid rgba(255, 255, 255, 0.3) !important;
        transition: all 0.2s ease-in-out;
    }

        .notif-bell-btn:hover {
            background: rgba(255, 255, 255, 0.3) !important;
            transform: scale(1.05);
        }

    @@media (max-width: 900px) {
        .mobile-topbar {
            display: flex !important;
        }

        .admin-sidebar {
            width: 260px !important;
            height: 100vh !important;
            height: 100dvh;
            position: fixed !important;
            top: 0 !important;
            left: 0 !important;
            transform: translateX(-100%);
            transition: transform 0.25s ease;
            z-index: 1050;
            flex-direction: column !important;
            padding: 16px !important;
            overflow-y: auto !important;
        }

            .admin-sidebar.mobile-open {
                transform: translateX(0);
            }

            .admin-sidebar .nav {
                flex-direction: column !important;
                gap: 8px !important;
            }

        .admin-main-content {
            left: 0 !important;
            top: 56px !important;
            padding: 16px 20px !important;
        }
    }

    /* Slim top bar shown only on mobile, with a hamburger button to open the drawer */
    .mobile-topbar {
        display: none;
        position: fixed;
        top: 0;
        left: 0;
        right: 0;
        height: 56px;
        background-color: #0f172a;
        z-index: 1030;
        align-items: center;
        gap: 12px;
        padding: 0 16px;
    }

    .mobile-nav-toggle {
        background: transparent;
        border: none;
        color: #ffffff;
        font-size: 1.5rem;
        line-height: 1;
        padding: 4px;
    }

    .sidebar-backdrop {
        display: none;
        position: fixed;
        inset: 0;
        background: rgba(0, 0, 0, 0.5);
        z-index: 1040;
    }

        .sidebar-backdrop.show {
            display: block;
        }
</style>

<!-- MOBILE TOP BAR (hamburger + brand) -->
<div class="mobile-topbar">
    <button type="button" class="mobile-nav-toggle" aria-label="Toggle menu">
        <i class="bi bi-list"></i>
    </button>
    <span class="fw-bold text-white">TCMIT CANTEEN</span>
</div>
<div class="sidebar-backdrop"></div>

<div class="d-flex">
    

    <!-- STATIC FIXED SIDEBAR -->
    <div class="admin-sidebar text-white p-3 d-flex flex-column justify-content-between">
        <div>
            <!-- Top Branding & User Info -->
            <div class="d-flex align-items-center gap-3 mb-4 pb-3 border-bottom border-secondary border-opacity-25">
                <div class="bg-primary rounded-circle p-2 d-flex align-items-center justify-content-center shadow-sm" style="width: 42px; height: 42px; min-width: 42px;">
                    <i class="bi bi-cup-hot-fill text-white fs-5"></i>
                </div>
                <div class="text-truncate">
                    <h6 class="fw-bold m-0 text-white text-truncate" style="font-size: 0.95rem;">TCMIT CANTEEN</h6>
                    <span class="text-primary small fw-semibold" style="font-size: 0.75rem;">Staff Portal</span>
                </div>
            </div>

            <!-- Navigation Links -->
            <ul class="nav nav-pills flex-column gap-2">
                <li class="nav-item">
                    <!-- HIGHLIGHTED: Dashboard is now active -->
                    <a asp-action="Dashboard" class="nav-link active bg-primary fw-bold rounded-3 py-2 px-3"><i class="bi bi-grid-fill me-2 fs-5 align-middle"></i> Dashboard</a>
                </li>
                <li class="nav-item">
                    <a asp-action="FullMenu" class="nav-link text-secondary fw-semibold rounded-3 py-2 px-3 text-white-50"><i class="bi bi-journal-text me-2 fs-5 align-middle"></i> Canteen Menu</a>
                </li>
                <li class="nav-item">
                    <a asp-action="Orders" class="nav-link text-secondary fw-semibold rounded-3 py-2 px-3 text-white-50"><i class="bi bi-clock-history me-2 fs-5 align-middle"></i> My Orders</a>
                </li>
                <li class="nav-item">
                    <a asp-action="Vault" class="nav-link text-secondary fw-semibold rounded-3 py-2 px-3 text-white-50"><i class="bi bi-safe-fill me-2 fs-5 align-middle"></i> Token Vault</a>
                </li>
                <li class="nav-item">
                    <a asp-action="Statements" class="nav-link text-secondary fw-semibold rounded-3 py-2 px-3 text-white-50"><i class="bi bi-file-earmark-text-fill me-2 fs-5 align-middle"></i> Statement</a>
                </li>
                <li class="nav-item">
                    <a asp-action="Notifications" class="nav-link text-secondary fw-semibold rounded-3 py-2 px-3 text-white-50"><i class="bi bi-bell-fill me-2 fs-5 align-middle"></i> Notifications</a>
                </li>
                <li class="nav-item">
                    <a asp-action="Profile" class="nav-link text-secondary fw-semibold rounded-3 py-2 px-3 text-white-50"><i class="bi bi-person-circle me-2 fs-5 align-middle"></i> Profile</a>
                </li>
            </ul>
        </div>

        <!-- Logout Button (Pinned to Bottom) -->
        <div class="pt-3 border-top border-secondary border-opacity-25">
            <form asp-controller="Account" asp-action="Logout" method="post">
                @Html.AntiForgeryToken()
                <button type="submit" class="btn text-danger w-100 text-start fw-bold p-0 border-0 bg-transparent">
                    <i class="bi bi-box-arrow-left me-2 fs-5 align-middle"></i> Logout
                </button>
            </form>
        </div>
    </div>

    <!-- MAIN SCROLLABLE CONTENT AREA -->
    <div class="admin-main-content">

        <!-- Welcome Banner with Notification Bell -->
        <div class="card border-0 shadow-sm rounded-4 bg-primary text-white p-4 mb-4">
            <div class="d-flex justify-content-between align-items-center">
                <div>
                    <h2 class="fw-bold text-white m-0">Welcome, @(user?.FullName ?? "Staff Member")! ☕</h2>
                    <p class="text-white-50 small mt-1 mb-0">Check out today's featured canteen items below.</p>
                </div>

                <!-- Circular Notification Bell Icon Button -->
                <div class="position-relative">
                    <button type="button" class="btn notif-bell-btn rounded-circle text-white d-flex align-items-center justify-content-center shadow-sm p-0" data-bs-toggle="modal" data-bs-target="#notificationModal" title="View Notifications">
                        <i class="bi bi-bell-fill fs-5"></i>
                    </button>
                    @if (notifications.Any(n => !n.IsRead))
                    {
                        <span class="position-absolute top-0 start-100 translate-middle p-2 bg-danger border border-2 border-white rounded-circle"></span>
                    }
                </div>
            </div>
        </div>

        @if (TempData["Success"] != null)
        {
            <div class="alert alert-success alert-dismissible fade show rounded-4 border-0 shadow-sm mb-4" role="alert">
                <i class="bi bi-check-circle-fill me-2"></i> @TempData["Success"]
                <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
            </div>
        }

        <!-- Featured Specials Preview -->
        <div class="d-flex justify-content-between align-items-center mb-3">
            <h5 class="fw-bold text-dark m-0">Today's Specials Preview</h5>
            <a asp-action="FullMenu" class="text-primary fw-semibold small text-decoration-none">See All Menu Items &rarr;</a>
        </div>

        <div class="row g-3 mb-4">
            @if (!featuredItems.Any())
            {
                <div class="col-12 text-center py-4 bg-white rounded-4 shadow-sm border">
                    <p class="text-muted m-0">No special items available today.</p>
                </div>
            }
            else
            {
                @foreach (var item in featuredItems)
                {
                    <div class="col-md-6 col-lg-3">
                        <div class="card border-0 shadow-sm rounded-4 bg-white h-100 overflow-hidden">
                            <img src="@(string.IsNullOrEmpty(item.ImageUrl) ? "/images/placeholder.png" : item.ImageUrl)" class="card-img-top" style="height: 140px; object-fit: cover;" alt="@item.Name" />
                            <div class="card-body p-3 d-flex flex-column justify-content-between">
                                <div>
                                    <h6 class="fw-bold text-dark mb-1">@item.Name</h6>
                                    <p class="text-muted small text-truncate mb-2">@item.Description</p>
                                </div>
                                <div class="d-flex justify-content-between align-items-center">
                                    <!-- BEFORE (With yellow background pill) -->
                                    <!-- AFTER (Clean text without yellow pill background) -->
                                    <span class="fw-bold text-primary">
                                        <i class="bi bi-coin text-warning me-1"></i>@item.Price.ToString("N0")
                                    </span>
                                    <a asp-action="FullMenu" class="btn btn-sm btn-outline-primary rounded-pill px-3 fw-semibold">Order</a>
                                </div>
                            </div>
                        </div>
                    </div>
                }
            }
        </div>

        <!-- Recent Orders Section -->
        <h5 class="fw-bold text-dark mb-3">Recent Staff Orders</h5>
        <div class="card border-0 shadow-sm rounded-4 bg-white overflow-hidden mb-4">
            @if (!recentOrders.Any())
            {
                <div class="p-4 text-center">
                    <p class="text-muted m-0">No recent staff orders placed.</p>
                </div>
            }
            else
            {
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0 text-nowrap w-100">
                        <thead class="bg-light">
                            <tr>
                                <th class="ps-4">Token</th>
                                <th>Order Date</th>
                                <th>Total Amount</th>
                                <th>Status</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var order in recentOrders)
                            {
                                <tr>
                                    <td class="ps-4 fw-bold text-primary">#@order.Id.ToString("D3")</td>
                                    <td class="small text-muted">@order.OrderTime.ToString("yyyy-MM-dd HH:mm")</td>
                                    <!-- UPDATED: Token coin icon used for order amount -->
                                    <td class="fw-bold text-dark">
                                        <i class="bi bi-coin text-warning me-1"></i>@order.TotalAmount.ToString("N0") Tokens
                                    </td>
                                    <td>
                                        <span class="badge rounded-pill px-3 py-2 fw-bold bg-warning-subtle text-warning border border-warning-subtle">
                                            @order.Status
                                        </span>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>
    </div>
</div>

<!-- NOTIFICATION MODAL -->
<div class="modal fade" id="notificationModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 rounded-4 shadow">
            <div class="modal-header border-0 pb-0">
                <h5 class="fw-bold text-dark m-0"><i class="bi bi-bell-fill text-primary me-2"></i>Order Notifications</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body p-4">
                @if (!notifications.Any())
                {
                    <div class="text-center py-4">
                        <i class="bi bi-bell-slash fs-1 text-muted d-block mb-2"></i>
                        <p class="text-muted small m-0">No notifications yet.</p>
                    </div>
                }
                else
                {
                    <div class="list-group list-group-flush">
                        @foreach (var notif in notifications)
                        {
                            <div class="list-group-item px-0 py-2 border-bottom">
                                <div class="d-flex justify-content-between align-items-center mb-1">
                                    <h6 class="fw-bold text-dark m-0">@notif.Title</h6>
                                    <small class="text-muted" style="font-size: 0.75rem;">@notif.CreatedAt.ToString("MMM dd, hh:mm tt")</small>
                                </div>
                                <p class="text-muted small m-0">@notif.Message</p>
                            </div>
                        }
                    </div>
                }
            </div>
        </div>
    </div>
</div>